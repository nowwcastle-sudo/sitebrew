# 줄바꿈은 저장소·작업 사본 모두 LF 로 고정한다. 생성기가 출력물을 바이트 단위로 비교하고(check:regen·kits.test),
# core.autocrlf=true 인 Windows 새 checkout 에서 CRLF 가 섞이면 테스트가 조용히 달라진다(T9-I1).
# Sitebrew: the LF rule is written per top-level entry, leaving out plugins/. The plugin directory refuses a plugin whose files a .gitattributes
# rewrites at checkout, and line-ending conversion counts. Re-generated by the export (_tools/gitattributes.mjs) from the entries that exist.
/.agents/** text=auto eol=lf
/.claude-plugin/** text=auto eol=lf
/.gitattributes text=auto eol=lf
/.githooks/** text=auto eol=lf
/.github/** text=auto eol=lf
/.gitignore text=auto eol=lf
/.gitleaks.toml text=auto eol=lf
/.nvmrc text=auto eol=lf
/.prettierignore text=auto eol=lf
/.prettierrc text=auto eol=lf
/AGENT_INSTALL.md text=auto eol=lf
/AGENTS.md text=auto eol=lf
/ai/** text=auto eol=lf
/app/** text=auto eol=lf
/ci/** text=auto eol=lf
/CLAUDE.md text=auto eol=lf
/components.json text=auto eol=lf
/CONTRIBUTING.md text=auto eol=lf
/docs/** text=auto eol=lf
/eslint.config.mjs text=auto eol=lf
/factory/** text=auto eol=lf
/get.ps1 text=auto eol=lf
/install.ps1 text=auto eol=lf
/launch-factory/** text=auto eol=lf
/LICENSE text=auto eol=lf
/next.config.ts text=auto eol=lf
/osv-scanner.toml text=auto eol=lf
/package-lock.json text=auto eol=lf
/package.json text=auto eol=lf
/packages/** text=auto eol=lf
/postcss.config.mjs text=auto eol=lf
/public/** text=auto eol=lf
/README.es.md text=auto eol=lf
/README.ja.md text=auto eol=lf
/README.ko.md text=auto eol=lf
/README.md text=auto eol=lf
/README.zh-CN.md text=auto eol=lf
/references/** text=auto eol=lf
/registry/** text=auto eol=lf
/registry.json text=auto eol=lf
/THIRD_PARTY_NOTICES.md text=auto eol=lf
/tsconfig.json text=auto eol=lf
/types/** text=auto eol=lf

