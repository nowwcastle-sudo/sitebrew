#!/bin/sh
# pre-push: 이번에 올리는 커밋 범위에서 비밀값을 찾는다(gitleaks, 이 저장소 .gitleaks.toml). gitleaks 가 설치돼 있을 때만 돈다 — 없으면 설치 방법을 알리고 통과시킨다.
# 켜기(저장소마다 한 번):  git config core.hooksPath .githooks
# git 이 표준입력으로 "<local ref> <local sha> <remote ref> <remote sha>" 줄을 준다.
bin="${WF_GITLEAKS_BIN:-gitleaks}"
if [ "${SKIP_GITLEAKS:-}" = "1" ]; then
  echo "[pre-push] SKIP_GITLEAKS=1 — 비밀값 검사를 건너뛴다(CI 는 그대로 검사한다)" >&2
  exit 0
fi
if ! command -v "$bin" >/dev/null 2>&1; then
  echo "[pre-push] gitleaks 가 설치돼 있지 않아 비밀값 검사를 건너뛴다(CI 가 같은 검사를 한다)." >&2
  echo "  설치(Windows):  winget install Gitleaks.Gitleaks   또는   scoop install gitleaks" >&2
  exit 0
fi
root="$(git rev-parse --show-toplevel)"
zero="0000000000000000000000000000000000000000"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # 가지 삭제
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes" # 새 가지: 어느 원격에도 없는 커밋만
  else
    range="$remote_sha..$local_sha"
  fi
  "$bin" git --config "$root/.gitleaks.toml" --redact --no-banner --verbose "--log-opts=$range" "$root" || status=1
done
exit $status
