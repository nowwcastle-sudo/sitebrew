{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "font-orbit",
  "type": "registry:font",
  "title": "Orbit",
  "description": "web-factory 폰트 키트: Orbit (Google Fonts, OFL-1.1)",
  "font": {
    "family": "'Orbit', sans-serif",
    "provider": "google",
    "import": "Orbit",
    "variable": "--font-orbit-wf",
    "weight": [
      "400"
    ],
    "subsets": [
      "latin"
    ],
    "dependency": "@fontsource/orbit"
  },
  "meta": {
    "license": "OFL-1.1",
    "licenseUrl": "https://github.com/google/fonts/blob/main/ofl/orbit/OFL.txt",
    "source": "https://fonts.google.com/specimen/Orbit",
