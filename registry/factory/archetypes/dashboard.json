  "imagePolicy": {
    "photos": "사진 슬롯 없음",
    "dataImages": "real-required — 데이터에서 온 것(아바타·상품 썸네일·첨부)만",
    "emptyState": "illustration — 사이트 전체 한 스타일, 없으면 아이콘 + 문장",
    "stockOrGenerated": "장식으로 쓰지 않음",
    "sampleData": "예시 표시. 실데이터가 없으면 현실적 분포의 합성 데이터(둥근 수·같은 패턴 금지)"
  },
  "contentSchemaHints": [
    "decision: { dashboard_type: operational|analytical|strategic, refresh } — 결정 기록 필수 필드(db-01)",
    "kpis[]: { id, label, value, unit, baseline{target|range|comparePeriod}, delta, rank }",
    "alerts[]: { id, severity, recordUrl, actions[] }",
    "table: { columns[]{id,label,numeric}, density: 32|40|48|64, rows[] }",
    "chart data → 대응하는 데이터 표(§11-B)"
  ],
  "references": [
    {
      "url": "https://plausible.io/plausible.io",
      "why": "로그아웃으로 열리는 실제 분석 대시보드: 필터·기간 한 줄 → KPI 6개(델타) → 선 그래프 → 탭 분해 패널 5개(KPI 타일이 div onclick인 점은 반례)"
    },
