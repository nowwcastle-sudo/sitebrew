  "imagePolicy": {
    "soldItemsSpacesStaff": "real-required — 사장님이 준 실사만(판정 2026-09-26, §6-A 단서). 없으면 비율 고정 빈 슬롯(「매장 사진 자리」)으로 납품",
    "mood": "generated-ok — 판매 대상이 아닌 분위기 컷에만, 표기",
    "stock": "금지",
    "clinic": "전후 사진·수술 장면 금지",
    "map": "이미지 아님 — 지도 링크 버튼"
  },
  "contentSchemaHints": [
    "business: { name, subtype(Bakery|CafeOrCoffeeShop|Restaurant|Dentist|MedicalClinic|HairSalon…), address, telephone(+82), geo(소수점 5자리 이상), url, openingHoursSpecification[] } → 화면·LocalBusiness 하위 유형 JSON-LD를 한 객체에서",
    "menu[]: { name, price, photo? } — 음식점은 JSON-LD menu·servesCuisine",
    "notices[]: { date, text }",
    "branches[]: { name, url, address, todayHours, telephone, naverMapUrl, kakaoMapUrl }",
    "booking: { primaryChannel: naver|catchtable|kakao|tel, url, secondary[] }",
    "variant: store|clinic — clinic이면 후기 칸 0"
  ],
