    "caseStudy: { meta{client,services,year,role}, challenge, role, process[], solution, results[], next }",
    "contact: { email, inquiryUrl? }"
  ],
  "references": [
    {
      "url": "https://www.pentagram.com",
      "why": "첫 작업 카드가 첫 화면 맨 위, 분야별 최신 작업 묶음, 작은 UI 글자로 작업 이미지가 위계를 맡음, 이메일 글자(H1이 로고인 점은 따르지 않음)"
    },
    {
      "url": "https://locomotive.ca/en",
      "why": "선언 H1 → 대표작 → 전체 보기 → 글·문화 → Let's talk의 짧은 순서(캔버스 의존·H1 이모지는 따르지 않음)"
    },
    {
      "url": "https://www.instrument.com",
      "why": "대표작 → 고객 명단 → 서비스 → 수상 → 목적 → 소식 → 프로젝트 문의(H1 없음·12px 라벨은 따르지 않음)"
    },
    {
      "url": "https://www.wearecollins.com",
      "why": "한 문장 선언(세리프 72px) 뒤 섹션 셋과 Work with us로 끝나는 절제"
    },
    {
      "url": "https://www.studiofreight.com",
      "why": "내비 Work·Info·News·Contact와 짧은 선언 H1의 최소 구성(가상 스크롤 추정 — §8-5 확인 필요)"
    }
