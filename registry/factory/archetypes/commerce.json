  "contentSchemaHints": [
    "products[]: { slug, name, price, listPrice?, unitPrice?{amount,per}, options[]{name, values[]{label, soldOut}}, thumbs[], origin? } — 옵션은 보이는 버튼으로 렌더(select 금지)",
    "business: { name, ceo, address, tel, email, bizNo, mailOrderNo, ftcLookupUrl, privacyOfficer?, bankAccount?{bank,number,holder}, escrowProvider? }",
    "shipping: { fee, freeThreshold, courier, leadDays } — 구매 영역과 장바구니에서 같은 객체",
    "wishlist: 비로그인 로컬 저장 → 로그인 시 병합"
  ],
  "references": [
    {
      "url": "https://www.pointofview.kr",
      "why": "푸터에 대표자·주소·사업자번호·통신판매·개인정보관리책임자·계좌 텍스트, 카카오톡 채널, 키워드 검색(진입 팝업은 따르지 않음)"
    },
    {
      "url": "https://marhenj.com",
      "why": "BEST → NEW → SELECTION → 사회적 증거의 명확한 순서, 사업자번호 옆 [Check] 조회 링크(무료배송을 상단 띠에만 두는 점은 따르지 않음)"
