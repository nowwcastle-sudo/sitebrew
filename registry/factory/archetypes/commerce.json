    },
    {
      "url": "https://www.onionkr.com/product/list.html?cate_no=50",
      "why": "작은 가게의 단순한 목록 격자, 초기 화면 푸터 법정 표시(구매 경로가 자사몰·스마트스토어로 갈림)"
    }
  ],
  "legalRequirements": [
    {
      "basis": "전자상거래법 제10조·시행규칙 제7조",
      "appliesWhen": "사이버몰 운영(항상)",
      "requirement": "초기 화면에 상호·대표자·주소(불만 처리 주소 포함)·전화·이메일·사업자등록번호·이용약관 링크·공정위 사업자정보 공개페이지 연결. 모바일 순차 표시 허용 조항이 있으나 §10-A 「푸터는 접지 않는다」를 따른다",
      "source": "https://www.law.go.kr/LSW/lsLinkCommonInfo.do?lsJoLnkSeq=1022342373"
    },
    {
      "basis": "전자상거래법 제13조②10",
      "appliesWhen": "선지급식(무통장입금 포함) 판매",
      "requirement": "결제대금예치(에스크로) 또는 소비자피해보상보험 선택 가능 문구를 결제 수단 근처와 푸터에. 무통장 계좌는 은행·계좌번호·예금주 함께",
      "source": "https://elaw.klri.re.kr/kor_service/lawViewMultiContent.do?hseq=38513"
    },
    {
      "basis": "상품정보제공 고시(농수산물·가공식품)",
      "appliesWhen": "식품 판매",
      "requirement": "원산지 안내를 상시 메뉴나 상세 고정 자리에",
      "source": "https://www.law.go.kr/LSW/admRulInfoP.do?admRulSeq=2000000026532"
    }
  ],
