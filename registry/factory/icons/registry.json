{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "items": [
    {
      "name": "icons-lucide",
      "type": "registry:item",
      "title": "아이콘 lucide",
      "description": "web-factory 아이콘: 정본 이름 → lucide 어댑터 + Icon(16·20·24, currentColor, 라벨 없으면 aria-hidden)",
      "files": [
        {
          "path": "lucide.ts",
          "type": "registry:component",
          "target": "@components/icons/lucide.ts"
        },
        {
          "path": "icon.tsx",
          "type": "registry:component",
          "target": "@components/icons/icon.tsx"
        }
      ],
      "dependencies": [
        "lucide-react@^1.49.0"
      ],
      "registryDependencies": [],
      "css": {
        "@layer base": {
          "svg.lucide": {
            "stroke-width": "var(--icon-stroke, 2)",
            "stroke-linecap": "var(--icon-linecap, round)",
            "stroke-linejoin": "var(--icon-linejoin, round)"
          }
        }
      },
      "meta": {
        "adapter": "lucide.ts"
      }
    },
    {
      "name": "icons-phosphor",
