{
  "name": "sitebrew",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.13.0",
    "npm": ">=11.6.2"
  },
  "scripts": {
    "predev": "npm run qa:axes && npm run qa:recipes && npm run qa:blocks && npm run qa:presets",
    "dev": "next dev",
    "prebuild": "npm run qa:axes && npm run qa:recipes && npm run qa:blocks && npm run qa:presets",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "pretypecheck": "npm run qa:axes && npm run qa:recipes && npm run qa:blocks && npm run qa:presets",
    "typecheck": "tsc --noEmit",
    "setup": "node factory/scripts/setup.mjs",
    "readme:check": "node factory/scripts/readme-check.mjs",
    "registry:gen": "node factory/scripts/gen-registry.mjs",
    "gen:styles": "node factory/scripts/compile-styles.mjs --src registry/factory/ui-src --out registry/factory/ui --css registry/factory/styles/base.css",
    "registry:check": "npx shadcn@4.21.0 build -o .tmp/r",
    "registry:pincheck": "node factory/scripts/pincheck.mjs",
    "registry:closure": "node factory/scripts/install-closure.mjs",
    "blocks:check": "node factory/scripts/blocks.mjs --check",
    "lint:ui": "node factory/qa/lint-ui.mjs",
    "qa:shrunk": "node factory/qa/shrunk.mjs",
    "qa:hit": "node factory/qa/hit-area.mjs",
    "gen:radius": "node factory/scripts/gen-radius-axis.mjs",
    "gen:recipes": "node factory/scripts/recipe.mjs",
    "gen:all": "node factory/scripts/gen-all.mjs",
    "check:regen": "node factory/scripts/gen-all.mjs --check",
    "ci:verify": "node ci/verify.mjs",
    "ci:tools": "node ci/tools.mjs fetch",
    "ci:test": "node ci/test-light.mjs",
    "ci:test:heavy": "node ci/test-heavy.mjs",
    "stamp": "node factory/stamp/stamp.mjs",
    "qa:axes": "node factory/scripts/gen-axes-gallery.mjs",
    "qa:measure": "node factory/qa/axes-measure.mjs",
    "qa:recipes": "node factory/scripts/gen-recipes-gallery.mjs",
    "qa:blocks": "node factory/scripts/gen-blocks-gallery.mjs",
    "qa:presets": "node factory/scripts/gen-presets-gallery.mjs",
    "qa:shell": "node factory/qa/shell-focus.mjs",
    "qa:a11y": "node factory/qa/a11y-gate.mjs",
    "qa:marketing": "node factory/qa/marketing-gate.mjs",
    "qa:ops": "node factory/qa/ops-gate.mjs",
    "qa:marketing-site": "node factory/qa/marketing-site.mjs",
    "qa:page-visual": "node factory/qa/page-visual.mjs",
    "qa:clipboard": "node factory/qa/clipboard-check.mjs",
    "qa:lang": "node factory/qa/lang-mix.mjs",
    "qa:signed-out": "node factory/qa/signed-out-access.mjs",
    "qa:agent-boundary": "node factory/qa/agent-boundary.mjs",
    "qa:marketing:blocks": "node factory/qa/marketing-blocks.mjs",
    "qa:swap": "node factory/scripts/recipe-swap.mjs",
    "qa:distinct": "node factory/scripts/recipes-distinct.mjs",
    "qa:diversity": "node factory/scripts/recipes-diversity.mjs",
    "board:shots": "node factory/board/recipe-board/shots.mjs",
    "board:gates": "node factory/board/recipe-board/gates.mjs",
    "board:hero-contrast": "node factory/board/recipe-board/hero-contrast.mjs",
    "board:hero-motion": "node factory/board/recipe-board/hero-motion.mjs",
    "board:ssr-flash": "node factory/board/recipe-board/ssr-flash.mjs",
    "board:build": "node factory/board/recipe-board/build.mjs",
    "board:video": "node factory/board/recipe-board/video.mjs",
    "board:build2": "node factory/board/recipe-board/build2.mjs",
    "board:scenes": "node factory/board/scene-board/jobs.mjs && node factory/board/scene-board/capture.mjs && node factory/board/scene-board/build.mjs",
    "blocks:gates": "node factory/board/block-board/gates.mjs",
    "blocks:states": "node factory/board/block-board/states.mjs",
    "blocks:a11y": "node factory/board/block-board/a11y.mjs",
    "blocks:visual": "node factory/board/block-board/visual.mjs",
    "blocks:visual:accept": "node factory/board/block-board/visual.mjs --accept",
    "board:direction": "node factory/board/direction-board/build.mjs",
    "board:record": "node factory/board/direction-board/record.mjs",
    "board:promote": "node factory/board/promote.mjs",
    "board:prescreen": "node factory/board/prescreen.mjs",
    "media:fetch": "node factory/media/fetch-pexels.mjs",
    "media:build": "node factory/media/build-media.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@lottiefiles/dotlottie-web": "0.80.0",
    "@phosphor-icons/react": "^2.1.10",
    "@shadcn/react": "^0.3.1",
    "@tabler/icons-react": "^3.48.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "gsap": "3.15.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "pretendard": "^1.3.9",
    "pretendard-gov": "^1.3.9",
    "react": "19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.13.3",
    "recharts": "^3.8.0",
    "shadcn": "^4.21.0",
    "three": "0.186.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "lighthouse": "13.5.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
