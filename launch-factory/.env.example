# launch-factory 환경 변수 — 이름만 적는다. 값은 여기·저장소·로그 어디에도 넣지 않는다.
# 읽는 순서: 프로세스 환경. Windows 사용자 환경 대체 읽기는 FACTORY_USER_ENV=1 일 때만 켜진다(기본 꺼짐). 검사는 @launch-factory/env 의 loadAppEnv() 가 한다.
# 빠진 이름은 켜질 때 한 번에 모두 알려 준다(값은 알리지 않는다).

# mock | live — 필수. mock 이면 아래 공급자 키 없이 목 어댑터로 켜진다. 없으면 켜지지 않는다(조용히 mock 으로 가지 않는다).
# 개발: mock (키 없이 켜진다 — 개발 서버는 비워 두어도 mock) · 공개(배포): live (아래 공급자 키가 모두 필요하다).
# mock 은 개발 전용이다 — 운영 실행(NODE_ENV=production: next build·next start, Vercel 배포)에서 mock 이면 켜질 때 멈춘다. 이 칸을 mock 으로 채운 채 배포하지 않는다.
# (내 기계에서 운영 빌드를 시험만 할 때만 LF_ALLOW_MOCK_PROD=1 을 따로 준다. 배포 환경에는 넣지 않는다.)
LF_MODE=
# mock 전용(선택) — 결제 관리 화면이 보여 줄 가짜 구독 상태: none·trialing·active(기본)·past_due·paused·canceled·expired. live 에서는 쓰지 않는다.
# 개발 서버(next dev)는 LF_MODE 가 없으면 mock 으로 켜진다(template/next.config.ts). 빌드·운영 서버는 LF_MODE 가 없으면 멈춘다.
LF_MOCK_SUB=

# ── 공급자 비밀값: live 에서 모두 필수, mock 에서는 선택(넣었으면 형식만 본다) ──
# postgres:// 또는 postgresql:// (Supabase 풀러 6543)
DATABASE_URL=
# 32자 이상
BETTER_AUTH_SECRET=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# 설정값(비밀 아님, 운영자 할 일 O3). Paddle.js 클라이언트 토큰: test_… = 샌드박스, live_… = 실결제. 비워 두면 결제는 Paddle 결제 링크로 이동한다(template/lib/site-keys.ts)
PADDLE_CLIENT_TOKEN=
# 설정값. 실결제(production) 스위치 — 운영자만 1 로 넣는다. 비워 두면 샌드박스다(packages/billing-paddle). 개발 기계·doctor sandbox 에서는 넣지 않는다
LF_PADDLE_LIVE=
RESEND_API_KEY=
# Cloudflare Turnstile 서버 검증 비밀(운영자 할 일 O7). 가입·문의 폼의 봇 방어(@launch-factory/security/turnstile)
TURNSTILE_SECRET_KEY=

# ── 설정값(비밀 아님) ──
# PostHog 지역 호스트(운영자 할 일 O5): https://us.i.posthog.com 또는 https://eu.i.posthog.com. **선택** — live 에서 없으면 분석(PostHog)만 꺼진다: 분석 스크립트·동의 띠·쿠키 설정 링크·서버 계측이 없고 사이트는 켜진다(LFOBS, 운영자 결정 2026-10-05).
# **POSTHOG_PROJECT_KEY 도 선택이고, 이 둘 중 하나라도 없으면 분석이 꺼진다**(LFOBS2, 운영자 결정 2026-10-05). 있는데 지역을 못 정하는 값(프록시·http)이면 켜질 때 멈춘다. 국외 이전 고지·CSP 값은 @launch-factory/analytics-posthog 의 resolvePostHog·POSTHOG_CSP 가 이 값으로 정한다.
POSTHOG_HOST=
# PostHog 공개 프로젝트 키(phc_…, O5). **선택** — POSTHOG_HOST 와 둘 다 있을 때만 분석이 켜진다. 있는데 공백이 섞였으면 켜질 때 멈춘다. 개인 API 키(POSTHOG_PERSONAL_API_KEY)와 다르다.
POSTHOG_PROJECT_KEY=
# Sentry 프로젝트 DSN(운영자 할 일 O6): https://공개키@호스트[/경로]/프로젝트번호. **선택** — live 에서 없으면 오류 수집(Sentry)만 꺼지고 사이트는 켜진다. 있는데 모양이 틀리면 켜질 때 멈춘다.
# 브라우저 SDK 는 빌드 때 이 값을 받는다(template/next.config.ts) — 빌드와 실행 환경 양쪽에 같은 값을 둔다. mock 은 이 값이 있어도 보내지 않는다.
SENTRY_DSN=
# 소스맵 업로드(선택, 비밀값): 이 토큰이 있을 때만 빌드가 Sentry 로 소스맵을 올린다. 없으면 업로드를 끈다. 올릴 때는 SENTRY_ORG·SENTRY_PROJECT(조직·프로젝트 슬러그, 비밀 아님)도 함께 둔다. CI 에는 두지 않는다.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# 메일 발신 주소(운영자 할 일 O4): "이름 <주소@인증한도메인>". Resend 에서 DNS 인증한 도메인이어야 한다. live 에서 필수(createMailer 가 RESEND_API_KEY 와 함께 검사).
EMAIL_FROM=
# Turnstile 위젯 사이트 키(공개 값, O7). 조립 쪽이 폼에 위젯을 그릴 때 쓴다. mock 에서는 시험 키 1x00000000000000000000AA
TURNSTILE_SITE_KEY=
# 문의 알림을 받을 운영자 메일 주소(@launch-factory/inquiry owner.email). 개인정보라 저장소에 적지 않는다
INQUIRY_OWNER_EMAIL=

# ── 탈퇴 파기·거래기록 분리 보존(v0 Task 14, @launch-factory/account-lifecycle) — 검사 연결은 Task 10(대장 D12x) ──
# 비밀값. 32자 이상. 보존 거래기록의 가명 참조(subject_ref = HMAC-SHA256)를 만든다. BETTER_AUTH_SECRET 과 따로 두고 바꾸지 않는다(바꾸면 옛 기록을 이메일로 못 찾는다).
SUBJECT_REF_KEY=
# 비밀값. PostHog 개인 API 키(scope person:write) — 탈퇴자의 사람·이벤트·녹화 삭제(bulk_delete). 프로젝트 키(POSTHOG_PROJECT_KEY)와 다르다.
POSTHOG_PERSONAL_API_KEY=
# 설정값(비밀 아님). PostHog 프로젝트 숫자 id
POSTHOG_PROJECT_ID=

# ── 소셜 로그인(선택, 운영자 할 일 O8). 공급자마다 CLIENT_ID·CLIENT_SECRET 을 **둘 다** 넣으면 lib/launch/auth.ts 가 그 공급자를 켜고(live·mock 같은 규칙),
#    로그인·가입 화면에 그 공급자 버튼이 나온다. 하나만 넣으면 켜지 않는다(doctor 가 경고). 하나도 안 넣으면 이메일·비밀번호만.
#    공급자 콘솔에 등록할 콜백 주소: https://<도메인>/api/auth/callback/<google|kakao|naver> (로컬은 http://localhost:3000/api/auth/callback/<공급자>).
#    ID 는 설정값, SECRET 은 비밀값(대화·로그에 남기지 않는다). 카카오는 비즈 앱 인증 전엔 이메일을 주지 않는다 ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 기능 레지스트리 항목이 쓰는 이름(v0 Task 9, registry/*) ──
# 앱 주소(쿠키·콜백·메일 링크의 기준). mock 은 없으면 http://localhost:3000, live 는 필수
NEXT_PUBLIC_APP_URL=
# 비밀값. Vercel Cron 이 Authorization: Bearer 로 붙이는 값 — 없으면 Cron 경로는 401 이다
CRON_SECRET=
# 비밀값. Gumroad 액세스 토큰(대비 어댑터, 판매·구독 재조회)
GUMROAD_ACCESS_TOKEN=
# 비밀값. Gumroad 알림 주소의 공유 비밀(?key=)이자 결제 참조 서명 키
GUMROAD_PING_SECRET=
# 설정값(비밀 아님). 결제 실패 안내 메일(F11)을 우리가 보낼지: 기본 켜짐. 실결제 전환 때 Paddle Retain 을 켜기로 정했으므로(O30) Retain 을 켜면 이 값을 off 로 둔다(중복 메일 방지)
LF_PAYMENT_FAILED_EMAIL=
# 설정값(비밀 아님). EU 결제 국가에 팔지(F10): 기본 열림(운영자 결정 2026-10-08). off 로 닫는다(off·0·false·no). 닫힌 동안 EU 접속 지역·결제 국가는 결제 창 대신 안내를 본다
LF_EU_SALES=
# 설정값(비밀 아님). 광고성 메일(G07)을 한국 시각 21:00~08:00 에 보내지 않고 미루는 점검: 기본 켜짐. off 로 끈다(전자우편은 법상 야간 동의 대상이 아니다 — 시행령 제61조제2항). 광고성 메일은 아래 사업자 정보 중 상호·이메일·전화·주소가 모두 있어야 보낸다
LF_MARKETING_NIGHT_GUARD=

# ── 사업자 정보(K03 — 전자상거래법 제10조: 푸터에 상호·대표자·주소·전화·이메일·사업자등록번호·호스팅 제공자 표시) ──
# 제품마다 값이 다르다 — 공장 코드·예시에 실제 값을 넣지 않는다. 모두 선택이고 빈 칸은 화면에서 숨긴다(packages/env 의 filledBusinessInfo).
# live·preview 에서 표시 의무 칸이 비면 doctor 가 경고한다. 예시 값(시험용): Example Co. · +82 10-0000-0000
LF_BUSINESS_NAME=
LF_BUSINESS_OWNER=
LF_BUSINESS_ADDRESS=
LF_BUSINESS_PHONE=
LF_BUSINESS_EMAIL=
LF_BUSINESS_REG_NO=
# 통신판매업 신고번호는 신고 대상일 때만(간이과세자·직전 연도 거래 50회 미만은 면제 — 공정위 고시 2022-4)
LF_MAIL_ORDER_NO=
LF_HOSTING_PROVIDER=
