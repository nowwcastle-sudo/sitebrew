[
  { "id": "prefixed-live-key", "re": "\\b(?:sk|pk|rk)_(?:live|test)_[A-Za-z0-9]{12,}\\b" },
  { "id": "prefixed-api-key", "re": "\\b(?:re|ghp|gho|ghs|xoxb|xoxp)_[A-Za-z0-9]{20,}\\b" },
  { "id": "aws-access-key-id", "re": "\\bAKIA[0-9A-Z]{16}\\b" },
  { "id": "private-key-block", "re": "-----BEGIN [A-Z ]*PRIVATE KEY-----" },
  { "id": "long-hex", "re": "\\b[0-9a-fA-F]{40,}\\b" },
  { "id": "jwt", "re": "\\beyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\b" }
]
