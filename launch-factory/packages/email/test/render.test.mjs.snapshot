{
  "subject": "We received your inquiry to SampleCo",
  "html": "<!DOCTYPE html PUBLIC \\"-//W3C//DTD XHTML 1.0 Transitional//EN\\" \\"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\\"><html dir=\\"ltr\\" lang=\\"en\\"><head><meta content=\\"text/html; charset=UTF-8\\" http-equiv=\\"Content-Type\\"/><meta name=\\"x-apple-disable-message-reformatting\\"/><title>Your inquiry reached us.</title></head><body dir=\\"ltr\\" lang=\\"en\\" style=\\"background-color:#f6f6f4;margin:0;padding:0\\"><!--$--><!--html--><!--head--><div style=\\"display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0\\" data-skip-in-text=\\"true\\">Your inquiry reached us.<div> ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿</div></div><!--body--><table border=\\"0\\" width=\\"100%\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" align=\\"center\\"><tbody><tr><td dir=\\"ltr\\" lang=\\"en\\" style=\\"background-color:#f6f6f4;font-family:-apple-system, &#x27;Segoe UI&#x27;, &#x27;Apple SD Gothic Neo&#x27;, &#x27;Malgun Gothic&#x27;, sans-serif;margin:0;padding:24px 0\\"><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"max-width:560px;background-color:#ffffff;border-radius:8px;margin:0 auto\\"><tbody><tr style=\\"width:100%\\"><td style=\\"padding:32px\\"><h1 style=\\"color:#1a1a1a;font-size:22px;line-height:30px;margin:0 0 16px\\">We received your inquiry</h1><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">Hi there,</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">Thanks for getting in touch. We will reply to the contact details you left.</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 4px;margin-top:0;margin-right:0;margin-bottom:4px;margin-left:0\\">Reference: Q-7K3M9P2A</p><hr style=\\"width:100%;border:none;border-color:#e5e5e5;border-top:1px solid #eaeaea;margin:24px 0 16px\\"/><p style=\\"font-size:12px;line-height:18px;color:#777777;margin:0;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0\\">You are receiving this email because you sent an inquiry to SampleCo. If you did not send this inquiry, you can ignore this email.</p></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>",
  "text": "WE RECEIVED YOUR INQUIRY\\n\\nHi there,\\n\\nThanks for getting in touch. We will reply to the contact details you left.\\n\\nReference: Q-7K3M9P2A\\n\\n----------------------------------------\\n\\nYou are receiving this email because you sent an inquiry to SampleCo. If you did not send this inquiry, you can ignore this email."
}
`;

exports[`스냅숏: inquiryReceipt (ko) 1`] = `
{
  "subject": "SampleCo 문의를 받았어요",
  "html": "<!DOCTYPE html PUBLIC \\"-//W3C//DTD XHTML 1.0 Transitional//EN\\" \\"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\\"><html dir=\\"ltr\\" lang=\\"ko\\"><head><meta content=\\"text/html; charset=UTF-8\\" http-equiv=\\"Content-Type\\"/><meta name=\\"x-apple-disable-message-reformatting\\"/><title>보내 주신 문의가 잘 도착했어요.</title></head><body dir=\\"ltr\\" lang=\\"en\\" style=\\"background-color:#f6f6f4;margin:0;padding:0\\"><!--$--><!--html--><!--head--><div style=\\"display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0\\" data-skip-in-text=\\"true\\">보내 주신 문의가 잘 도착했어요.<div> ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿</div></div><!--body--><table border=\\"0\\" width=\\"100%\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" align=\\"center\\"><tbody><tr><td dir=\\"ltr\\" lang=\\"en\\" style=\\"background-color:#f6f6f4;font-family:-apple-system, &#x27;Segoe UI&#x27;, &#x27;Apple SD Gothic Neo&#x27;, &#x27;Malgun Gothic&#x27;, sans-serif;margin:0;padding:24px 0\\"><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"max-width:560px;background-color:#ffffff;border-radius:8px;margin:0 auto\\"><tbody><tr style=\\"width:100%\\"><td style=\\"padding:32px\\"><h1 style=\\"color:#1a1a1a;font-size:22px;line-height:30px;margin:0 0 16px\\">문의를 받았어요</h1><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">안녕하세요.</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">문의해 주셔서 고마워요. 남겨 주신 연락처로 답해 드릴게요.</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 4px;margin-top:0;margin-right:0;margin-bottom:4px;margin-left:0\\">접수 번호: Q-7K3M9P2A</p><hr style=\\"width:100%;border:none;border-color:#e5e5e5;border-top:1px solid #eaeaea;margin:24px 0 16px\\"/><p style=\\"font-size:12px;line-height:18px;color:#777777;margin:0;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0\\">SampleCo에 문의를 보내서 받는 메일이에요. 직접 보낸 문의가 아니면 이 메일은 무시해도 돼요.</p></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>",
  "text": "문의를 받았어요\\n\\n안녕하세요.\\n\\n문의해 주셔서 고마워요. 남겨 주신 연락처로 답해 드릴게요.\\n\\n접수 번호: Q-7K3M9P2A\\n\\n----------------------------------------\\n\\nSampleCo에 문의를 보내서 받는 메일이에요. 직접 보낸 문의가 아니면 이 메일은 무시해도 돼요."
}
`;

exports[`스냅숏: marketingAnnouncement (en) 1`] = `
{
  "subject": "(광고) Team plans are here",
  "html": "<!DOCTYPE html PUBLIC \\"-//W3C//DTD XHTML 1.0 Transitional//EN\\" \\"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\\"><html dir=\\"ltr\\" lang=\\"en\\"><head><meta content=\\"text/html; charset=UTF-8\\" http-equiv=\\"Content-Type\\"/><meta name=\\"x-apple-disable-message-reformatting\\"/><title>You can now share one workspace across your whole team.</title></head><body dir=\\"ltr\\" lang=\\"en\\" style=\\"background-color:#f6f6f4;margin:0;padding:0\\"><!--$--><!--html--><!--head--><div style=\\"display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0\\" data-skip-in-text=\\"true\\">You can now share one workspace across your whole team.<div> ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿</div></div><!--body--><table border=\\"0\\" width=\\"100%\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" align=\\"center\\"><tbody><tr><td dir=\\"ltr\\" lang=\\"en\\" style=\\"background-color:#f6f6f4;font-family:-apple-system, &#x27;Segoe UI&#x27;, &#x27;Apple SD Gothic Neo&#x27;, &#x27;Malgun Gothic&#x27;, sans-serif;margin:0;padding:24px 0\\"><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"max-width:560px;background-color:#ffffff;border-radius:8px;margin:0 auto\\"><tbody><tr style=\\"width:100%\\"><td style=\\"padding:32px\\"><h1 style=\\"color:#1a1a1a;font-size:22px;line-height:30px;margin:0 0 16px\\">Team plans are here</h1><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">Hi Jamie,</p><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" data-lf-promo=\\"true\\" style=\\"margin:0 0 12px\\"><tbody><tr><td><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">You can now share one workspace across your whole team.</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">Pay once for every seat.</p><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"margin:20px 0 8px\\"><tbody><tr><td><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"margin:0 0 12px\\"><tbody><tr><td><a href=\\"https://sampleco.test/pricing\\" style=\\"line-height:100%;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:#1a1a1a;border-radius:6px;color:#ffffff;font-size:15px;font-weight:600;padding:12px 20px;padding-top:12px;padding-right:20px;padding-bottom:12px;padding-left:20px\\" target=\\"_blank\\"><span><!--[if mso]><i style=\\"mso-font-width:500%;mso-text-raise:18px\\" hidden>&#8202;&#8202;</i><![endif]--></span><span style=\\"max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:9px\\">See team plans</span><span><!--[if mso]><i style=\\"mso-font-width:500%\\" hidden>&#8202;&#8202;&#8203;</i><![endif]--></span></a><p data-skip-in-text=\\"true\\" data-lf-fallback-link=\\"true\\" style=\\"font-size:12px;line-height:18px;color:#777777;margin:6px 0 0;word-break:break-all;margin-top:6px;margin-right:0;margin-bottom:0;margin-left:0\\">If the button doesn&#x27;t work, copy this link into your browser: <a href=\\"https://sampleco.test/pricing\\" style=\\"color:#555555;text-decoration-line:none;text-decoration:underline\\" target=\\"_blank\\">https://sampleco.test/pricing</a></p></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table><hr style=\\"width:100%;border:none;border-color:#e5e5e5;border-top:1px solid #eaeaea;margin:24px 0 16px\\"/><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" data-lf-ad-footer=\\"true\\"><tbody><tr><td><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">This is an advertisement sent by Example Co. to people who agreed to receive its marketing emails.</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">광고 메일이에요. Example Co.의 광고성 메일 수신에 동의하셔서 보내 드려요.</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">Don&#x27;t want these emails? Unsubscribe in one click. You don&#x27;t need to sign in.</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">이 메일을 더 받고 싶지 않다면 한 번에 수신거부할 수 있어요. 로그인하지 않아도 돼요.</p><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"margin:20px 0 8px\\"><tbody><tr><td><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"margin:0 0 12px\\"><tbody><tr><td><a href=\\"https://sampleco.test/api/marketing/unsubscribe?t=test-unsubscribe-token\\" style=\\"line-height:100%;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:#ffffff;border:1px solid #1a1a1a;border-radius:6px;color:#1a1a1a;font-size:15px;font-weight:600;padding:11px 19px;padding-top:11px;padding-right:19px;padding-bottom:11px;padding-left:19px\\" target=\\"_blank\\"><span><!--[if mso]><i style=\\"mso-font-width:475%;mso-text-raise:16.5px\\" hidden>&#8202;&#8202;</i><![endif]--></span><span style=\\"max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:8.25px\\">수신거부 / Unsubscribe</span><span><!--[if mso]><i style=\\"mso-font-width:475%\\" hidden>&#8202;&#8202;&#8203;</i><![endif]--></span></a><p data-skip-in-text=\\"true\\" data-lf-fallback-link=\\"true\\" style=\\"font-size:12px;line-height:18px;color:#777777;margin:6px 0 0;word-break:break-all;margin-top:6px;margin-right:0;margin-bottom:0;margin-left:0\\">If the button doesn&#x27;t work, copy this link into your browser: <a href=\\"https://sampleco.test/api/marketing/unsubscribe?t=test-unsubscribe-token\\" style=\\"color:#555555;text-decoration-line:none;text-decoration:underline\\" target=\\"_blank\\">https://sampleco.test/api/marketing/unsubscribe?t=test-unsubscribe-token</a></p></td></tr></tbody></table></td></tr></tbody></table><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 4px;margin-top:0;margin-right:0;margin-bottom:4px;margin-left:0\\">Sender: Example Co.</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 4px;margin-top:0;margin-right:0;margin-bottom:4px;margin-left:0\\">Email: hello@example.test</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 4px;margin-top:0;margin-right:0;margin-bottom:4px;margin-left:0\\">Phone: +82 10-0000-0000</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 4px;margin-top:0;margin-right:0;margin-bottom:4px;margin-left:0\\">Address: 1 Example-ro, Seoul 00000, KR</p></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>",
  "text": "TEAM PLANS ARE HERE\\n\\nHi Jamie,\\n\\nYou can now share one workspace across your whole team.\\n\\nPay once for every seat.\\n\\nSee team plans https://sampleco.test/pricing\\n\\n----------------------------------------\\n\\nThis is an advertisement sent by Example Co. to people who agreed to receive its marketing emails.\\n\\n광고 메일이에요. Example Co.의 광고성 메일 수신에 동의하셔서 보내 드려요.\\n\\nDon't want these emails? Unsubscribe in one click. You don't need to sign in.\\n\\n이 메일을 더 받고 싶지 않다면 한 번에 수신거부할 수 있어요. 로그인하지 않아도 돼요.\\n\\n수신거부 / Unsubscribe https://sampleco.test/api/marketing/unsubscribe?t=test-unsubscribe-token\\n\\nSender: Example Co.\\n\\nEmail: hello@example.test\\n\\nPhone: +82 10-0000-0000\\n\\nAddress: 1 Example-ro, Seoul 00000, KR"
}
`;

exports[`스냅숏: marketingAnnouncement (ko) 1`] = `
