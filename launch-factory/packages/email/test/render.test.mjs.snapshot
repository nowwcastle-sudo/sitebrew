le=\\"background-color:#f6f6f4;font-family:-apple-system, &#x27;Segoe UI&#x27;, &#x27;Apple SD Gothic Neo&#x27;, &#x27;Malgun Gothic&#x27;, sans-serif;margin:0;padding:24px 0\\"><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"max-width:560px;background-color:#ffffff;border-radius:8px;margin:0 auto\\"><tbody><tr style=\\"width:100%\\"><td style=\\"padding:32px\\"><h1 style=\\"color:#1a1a1a;font-size:22px;line-height:30px;margin:0 0 16px\\">Your subscription is canceled</h1><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">Hi Jamie,</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">You can keep using SampleCo until October 31, 2026.</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">You will not be charged again.</p><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"margin:20px 0 8px\\"><tbody><tr><td><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"margin:0 0 12px\\"><tbody><tr><td><a href=\\"https://sampleco.test/pricing\\" style=\\"line-height:100%;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:#ffffff;border:1px solid #1a1a1a;border-radius:6px;color:#1a1a1a;font-size:15px;font-weight:600;padding:11px 19px;padding-top:11px;padding-right:19px;padding-bottom:11px;padding-left:19px\\" target=\\"_blank\\"><span><!--[if mso]><i style=\\"mso-font-width:475%;mso-text-raise:16.5px\\" hidden>&#8202;&#8202;</i><![endif]--></span><span style=\\"max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:8.25px\\">Resubscribe</span><span><!--[if mso]><i style=\\"mso-font-width:475%\\" hidden>&#8202;&#8202;&#8203;</i><![endif]--></span></a><p data-skip-in-text=\\"true\\" data-lf-fallback-link=\\"true\\" style=\\"font-size:12px;line-height:18px;color:#777777;margin:6px 0 0;word-break:break-all;margin-top:6px;margin-right:0;margin-bottom:0;margin-left:0\\">If the button doesn&#x27;t work, copy this link into your browser: <a href=\\"https://sampleco.test/pricing\\" style=\\"color:#555555;text-decoration-line:none;text-decoration:underline\\" target=\\"_blank\\">https://sampleco.test/pricing</a></p></td></tr></tbody></table></td></tr></tbody></table><hr style=\\"width:100%;border:none;border-color:#e5e5e5;border-top:1px solid #eaeaea;margin:24px 0 16px\\"/><p style=\\"font-size:12px;line-height:18px;color:#777777;margin:0;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0\\">You are receiving this email because you have an account with SampleCo.</p></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>",
  "text": "YOUR SUBSCRIPTION IS CANCELED\\n\\nHi Jamie,\\n\\nYou can keep using SampleCo until October 31, 2026.\\n\\nYou will not be charged again.\\n\\nResubscribe https://sampleco.test/pricing\\n\\n----------------------------------------\\n\\nYou are receiving this email because you have an account with SampleCo."
}
`;

