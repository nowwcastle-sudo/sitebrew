exports[`스냅숏: passwordReset (en) 1`] = `
{
  "subject": "Reset your SampleCo password",
  "html": "<!DOCTYPE html PUBLIC \\"-//W3C//DTD XHTML 1.0 Transitional//EN\\" \\"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\\"><html dir=\\"ltr\\" lang=\\"en\\"><head><meta content=\\"text/html; charset=UTF-8\\" http-equiv=\\"Content-Type\\"/><meta name=\\"x-apple-disable-message-reformatting\\"/><title>Use this link to choose a new password for your SampleCo account.</title></head><body dir=\\"ltr\\" lang=\\"en\\" style=\\"background-color:#f6f6f4;margin:0;padding:0\\"><!--$--><!--html--><!--head--><div style=\\"display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0\\" data-skip-in-text=\\"true\\">Use this link to choose a new password for your SampleCo account.<div> ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿</div></div><!--body--><table border=\\"0\\" width=\\"100%\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" align=\\"center\\"><tbody><tr><td dir=\\"ltr\\" lang=\\"en\\" style=\\"background-color:#f6f6f4;font-family:-apple-system, &#x27;Segoe UI&#x27;, &#x27;Apple SD Gothic Neo&#x27;, &#x27;Malgun Gothic&#x27;, sans-serif;margin:0;padding:24px 0\\"><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"max-width:560px;background-color:#ffffff;border-radius:8px;margin:0 auto\\"><tbody><tr style=\\"width:100%\\"><td style=\\"padding:32px\\"><h1 style=\\"color:#1a1a1a;font-size:22px;line-height:30px;margin:0 0 16px\\">Reset your password</h1><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">Hi Jamie,</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">We received a request to reset the password of your SampleCo account. Use the button below to choose a new one.</p><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"margin:20px 0 8px\\"><tbody><tr><td><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"margin:0 0 12px\\"><tbody><tr><td><a href=\\"https://sampleco.test/api/auth/reset-password/test-token?callbackURL=%2Freset-password\\" style=\\"line-height:100%;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:#1a1a1a;border-radius:6px;color:#ffffff;font-size:15px;font-weight:600;padding:12px 20px;padding-top:12px;padding-right:20px;padding-bottom:12px;padding-left:20px\\" target=\\"_blank\\"><span><!--[if mso]><i style=\\"mso-font-width:500%;mso-text-raise:18px\\" hidden>&#8202;&#8202;</i><![endif]--></span><span style=\\"max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:9px\\">Choose a new password</span><span><!--[if mso]><i style=\\"mso-font-width:500%\\" hidden>&#8202;&#8202;&#8203;</i><![endif]--></span></a><p data-skip-in-text=\\"true\\" data-lf-fallback-link=\\"true\\" style=\\"font-size:12px;line-height:18px;color:#777777;margin:6px 0 0;word-break:break-all;margin-top:6px;margin-right:0;margin-bottom:0;margin-left:0\\">If the button doesn&#x27;t work, copy this link into your browser: <a href=\\"https://sampleco.test/api/auth/reset-password/test-token?callbackURL=%2Freset-password\\" style=\\"color:#555555;text-decoration-line:none;text-decoration:underline\\" target=\\"_blank\\">https://sampleco.test/api/auth/reset-password/test-token?callbackURL=%2Freset-password</a></p></td></tr></tbody></table></td></tr></tbody></table><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">This link works for 1 hour. If it has expired, you can ask for a new one from the sign-in page.</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">If you did not ask for this, you can ignore this email. Your password will not change.</p><hr style=\\"width:100%;border:none;border-color:#e5e5e5;border-top:1px solid #eaeaea;margin:24px 0 16px\\"/><p style=\\"font-size:12px;line-height:18px;color:#777777;margin:0;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0\\">You are receiving this email because you have an account with SampleCo.</p></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>",
  "text": "RESET YOUR PASSWORD\\n\\nHi Jamie,\\n\\nWe received a request to reset the password of your SampleCo account. Use the button below to choose a new one.\\n\\nChoose a new password https://sampleco.test/api/auth/reset-password/test-token?callbackURL=%2Freset-password\\n\\nThis link works for 1 hour. If it has expired, you can ask for a new one from the sign-in page.\\n\\nIf you did not ask for this, you can ignore this email. Your password will not change.\\n\\n----------------------------------------\\n\\nYou are receiving this email because you have an account with SampleCo."
}
`;

exports[`스냅숏: passwordReset (ko) 1`] = `
{
  "subject": "SampleCo 비밀번호를 재설정해 주세요",
  "html": "<!DOCTYPE html PUBLIC \\"-//W3C//DTD XHTML 1.0 Transitional//EN\\" \\"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\\"><html dir=\\"ltr\\" lang=\\"ko\\"><head><meta content=\\"text/html; charset=UTF-8\\" http-equiv=\\"Content-Type\\"/><meta name=\\"x-apple-disable-message-reformatting\\"/><title>SampleCo 계정의 새 비밀번호를 정하는 링크예요.</title></head><body dir=\\"ltr\\" lang=\\"en\\" style=\\"background-color:#f6f6f4;margin:0;padding:0\\"><!--$--><!--html--><!--head--><div style=\\"display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0\\" data-skip-in-text=\\"true\\">SampleCo 계정의 새 비밀번호를 정하는 링크예요.<div> ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿</div></div><!--body--><table border=\\"0\\" width=\\"100%\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" align=\\"center\\"><tbody><tr><td dir=\\"ltr\\" lang=\\"en\\" style=\\"background-color:#f6f6f4;font-family:-apple-system, &#x27;Segoe UI&#x27;, &#x27;Apple SD Gothic Neo&#x27;, &#x27;Malgun Gothic&#x27;, sans-serif;margin:0;padding:24px 0\\"><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"max-width:560px;background-color:#ffffff;border-radius:8px;margin:0 auto\\"><tbody><tr style=\\"width:100%\\"><td style=\\"padding:32px\\"><h1 style=\\"color:#1a1a1a;font-size:22px;line-height:30px;margin:0 0 16px\\">비밀번호를 재설정해 주세요</h1><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">지민님, 안녕하세요.</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">SampleCo 계정의 비밀번호를 재설정해 달라는 요청을 받았어요. 아래 버튼을 눌러 새 비밀번호를 정해 주세요.</p><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"margin:20px 0 8px\\"><tbody><tr><td><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"margin:0 0 12px\\"><tbody><tr><td><a href=\\"https://sampleco.test/api/auth/reset-password/test-token?callbackURL=%2Freset-password\\" style=\\"line-height:100%;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:#1a1a1a;border-radius:6px;color:#ffffff;font-size:15px;font-weight:600;padding:12px 20px;padding-top:12px;padding-right:20px;padding-bottom:12px;padding-left:20px\\" target=\\"_blank\\"><span><!--[if mso]><i style=\\"mso-font-width:500%;mso-text-raise:18px\\" hidden>&#8202;&#8202;</i><![endif]--></span><span style=\\"max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:9px\\">새 비밀번호 정하기</span><span><!--[if mso]><i style=\\"mso-font-width:500%\\" hidden>&#8202;&#8202;&#8203;</i><![endif]--></span></a><p data-skip-in-text=\\"true\\" data-lf-fallback-link=\\"true\\" style=\\"font-size:12px;line-height:18px;color:#777777;margin:6px 0 0;word-break:break-all;margin-top:6px;margin-right:0;margin-bottom:0;margin-left:0\\">버튼이 열리지 않으면 아래 링크를 브라우저에 붙여 넣어 주세요: <a href=\\"https://sampleco.test/api/auth/reset-password/test-token?callbackURL=%2Freset-password\\" style=\\"color:#555555;text-decoration-line:none;text-decoration:underline\\" target=\\"_blank\\">https://sampleco.test/api/auth/reset-password/test-token?callbackURL=%2Freset-password</a></p></td></tr></tbody></table></td></tr></tbody></table><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">이 링크는 1시간 동안만 쓸 수 있어요. 시간이 지났다면 로그인 화면에서 다시 요청해 주세요.</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">요청한 적이 없다면 이 메일은 무시해도 돼요. 비밀번호는 바뀌지 않아요.</p><hr style=\\"width:100%;border:none;border-color:#e5e5e5;border-top:1px solid #eaeaea;margin:24px 0 16px\\"/><p style=\\"font-size:12px;line-height:18px;color:#777777;margin:0;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0\\">SampleCo 계정이 있어서 보내 드리는 메일이에요.</p></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>",
  "text": "비밀번호를 재설정해 주세요\\n\\n지민님, 안녕하세요.\\n\\nSampleCo 계정의 비밀번호를 재설정해 달라는 요청을 받았어요. 아래 버튼을 눌러 새 비밀번호를 정해 주세요.\\n\\n새 비밀번호 정하기 https://sampleco.test/api/auth/reset-password/test-token?callbackURL=%2Freset-password\\n\\n이 링크는 1시간 동안만 쓸 수 있어요. 시간이 지났다면 로그인 화면에서 다시 요청해 주세요.\\n\\n요청한 적이 없다면 이 메일은 무시해도 돼요. 비밀번호는 바뀌지 않아요.\\n\\n----------------------------------------\\n\\nSampleCo 계정이 있어서 보내 드리는 메일이에요."
}
`;

exports[`스냅숏: paymentFailed (en) 1`] = `
{
  "subject": "Your SampleCo payment didn't go through",
  "html": "<!DOCTYPE html PUBLIC \\"-//W3C//DTD XHTML 1.0 Transitional//EN\\" \\"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\\"><html dir=\\"ltr\\" lang=\\"en\\"><head><meta content=\\"text/html; charset=UTF-8\\" http-equiv=\\"Content-Type\\"/><meta name=\\"x-apple-disable-message-reformatting\\"/><title>Update your payment method to keep your plan.</title></head><body dir=\\"ltr\\" lang=\\"en\\" style=\\"background-color:#f6f6f4;margin:0;padding:0\\"><!--$--><!--html--><!--head--><div style=\\"display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0\\" data-skip-in-text=\\"true\\">Update your payment method to keep your plan.<div> ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿</div></div><!--body--><table border=\\"0\\" width=\\"100%\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" align=\\"center\\"><tbody><tr><td dir=\\"ltr\\" lang=\\"en\\" style=\\"background-color:#f6f6f4;font-family:-apple-system, &#x27;Segoe UI&#x27;, &#x27;Apple SD Gothic Neo&#x27;, &#x27;Malgun Gothic&#x27;, sans-serif;margin:0;padding:24px 0\\"><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"max-width:560px;background-color:#ffffff;border-radius:8px;margin:0 auto\\"><tbody><tr style=\\"width:100%\\"><td style=\\"padding:32px\\"><h1 style=\\"color:#1a1a1a;font-size:22px;line-height:30px;margin:0 0 16px\\">We couldn&#x27;t take your payment</h1><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">Hi Jamie,</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">Your last payment for SampleCo didn&#x27;t go through, so your plan is now past due.</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">Our payment provider will try your card again on October 5, 2026.</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">You can keep using your paid features until October 8, 2026. After that they pause until a payment goes through.</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">The quickest fix is to update your payment method.</p><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"margin:20px 0 8px\\"><tbody><tr><td><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"margin:0 0 12px\\"><tbody><tr><td><a href=\\"https://sampleco.test/account/billing\\" style=\\"line-height:100%;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:#1a1a1a;border-radius:6px;color:#ffffff;font-size:15px;font-weight:600;padding:12px 20px;padding-top:12px;padding-right:20px;padding-bottom:12px;padding-left:20px\\" target=\\"_blank\\"><span><!--[if mso]><i style=\\"mso-font-width:500%;mso-text-raise:18px\\" hidden>&#8202;&#8202;</i><![endif]--></span><span style=\\"max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:9px\\">Update payment method</span><span><!--[if mso]><i style=\\"mso-font-width:500%\\" hidden>&#8202;&#8202;&#8203;</i><![endif]--></span></a><p data-skip-in-text=\\"true\\" data-lf-fallback-link=\\"true\\" style=\\"font-size:12px;line-height:18px;color:#777777;margin:6px 0 0;word-break:break-all;margin-top:6px;margin-right:0;margin-bottom:0;margin-left:0\\">If the button doesn&#x27;t work, copy this link into your browser: <a href=\\"https://sampleco.test/account/billing\\" style=\\"color:#555555;text-decoration-line:none;text-decoration:underline\\" target=\\"_blank\\">https://sampleco.test/account/billing</a></p></td></tr></tbody></table></td></tr></tbody></table><hr style=\\"width:100%;border:none;border-color:#e5e5e5;border-top:1px solid #eaeaea;margin:24px 0 16px\\"/><p style=\\"font-size:12px;line-height:18px;color:#777777;margin:0;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0\\">You are receiving this email because you have an account with SampleCo.</p></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>",
  "text": "WE COULDN'T TAKE YOUR PAYMENT\\n\\nHi Jamie,\\n\\nYour last payment for SampleCo didn't go through, so your plan is now past due.\\n\\nOur payment provider will try your card again on October 5, 2026.\\n\\nYou can keep using your paid features until October 8, 2026. After that they pause until a payment goes through.\\n\\nThe quickest fix is to update your payment method.\\n\\nUpdate payment method https://sampleco.test/account/billing\\n\\n----------------------------------------\\n\\nYou are receiving this email because you have an account with SampleCo."
}
`;

exports[`스냅숏: paymentFailed (ko) 1`] = `
{
  "subject": "SampleCo 결제가 완료되지 않았어요",
  "html": "<!DOCTYPE html PUBLIC \\"-//W3C//DTD XHTML 1.0 Transitional//EN\\" \\"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\\"><html dir=\\"ltr\\" lang=\\"ko\\"><head><meta content=\\"text/html; charset=UTF-8\\" http-equiv=\\"Content-Type\\"/><meta name=\\"x-apple-disable-message-reformatting\\"/><title>구독을 유지하려면 결제 수단을 확인해 주세요.</title></head><body dir=\\"ltr\\" lang=\\"en\\" style=\\"background-color:#f6f6f4;margin:0;padding:0\\"><!--$--><!--html--><!--head--><div style=\\"display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0\\" data-skip-in-text=\\"true\\">구독을 유지하려면 결제 수단을 확인해 주세요.<div> ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿</div></div><!--body--><table border=\\"0\\" width=\\"100%\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" align=\\"center\\"><tbody><tr><td dir=\\"ltr\\" lang=\\"en\\" style=\\"background-color:#f6f6f4;font-family:-apple-system, &#x27;Segoe UI&#x27;, &#x27;Apple SD Gothic Neo&#x27;, &#x27;Malgun Gothic&#x27;, sans-serif;margin:0;padding:24px 0\\"><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"max-width:560px;background-color:#ffffff;border-radius:8px;margin:0 auto\\"><tbody><tr style=\\"width:100%\\"><td style=\\"padding:32px\\"><h1 style=\\"color:#1a1a1a;font-size:22px;line-height:30px;margin:0 0 16px\\">결제가 완료되지 않았어요</h1><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">지민님, 안녕하세요.</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">SampleCo의 최근 결제가 완료되지 않아 구독이 결제 지연 상태가 됐어요.</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">결제 대행사가 2026년 10월 5일에 카드를 다시 시도해요.</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">2026년 10월 8일까지는 유료 기능을 계속 쓸 수 있어요. 그 뒤에는 결제가 완료될 때까지 멈춰요.</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">가장 빠른 방법은 결제 수단을 바꾸는 거예요.</p><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"margin:20px 0 8px\\"><tbody><tr><td><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"margin:0 0 12px\\"><tbody><tr><td><a href=\\"https://sampleco.test/account/billing\\" style=\\"line-height:100%;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:#1a1a1a;border-radius:6px;color:#ffffff;font-size:15px;font-weight:600;padding:12px 20px;padding-top:12px;padding-right:20px;padding-bottom:12px;padding-left:20px\\" target=\\"_blank\\"><span><!--[if mso]><i style=\\"mso-font-width:500%;mso-text-raise:18px\\" hidden>&#8202;&#8202;</i><![endif]--></span><span style=\\"max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:9px\\">결제 수단 변경하기</span><span><!--[if mso]><i style=\\"mso-font-width:500%\\" hidden>&#8202;&#8202;&#8203;</i><![endif]--></span></a><p data-skip-in-text=\\"true\\" data-lf-fallback-link=\\"true\\" style=\\"font-size:12px;line-height:18px;color:#777777;margin:6px 0 0;word-break:break-all;margin-top:6px;margin-right:0;margin-bottom:0;margin-left:0\\">버튼이 열리지 않으면 아래 링크를 브라우저에 붙여 넣어 주세요: <a href=\\"https://sampleco.test/account/billing\\" style=\\"color:#555555;text-decoration-line:none;text-decoration:underline\\" target=\\"_blank\\">https://sampleco.test/account/billing</a></p></td></tr></tbody></table></td></tr></tbody></table><hr style=\\"width:100%;border:none;border-color:#e5e5e5;border-top:1px solid #eaeaea;margin:24px 0 16px\\"/><p style=\\"font-size:12px;line-height:18px;color:#777777;margin:0;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0\\">SampleCo 계정이 있어서 보내 드리는 메일이에요.</p></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>",
  "text": "결제가 완료되지 않았어요\\n\\n지민님, 안녕하세요.\\n\\nSampleCo의 최근 결제가 완료되지 않아 구독이 결제 지연 상태가 됐어요.\\n\\n결제 대행사가 2026년 10월 5일에 카드를 다시 시도해요.\\n\\n2026년 10월 8일까지는 유료 기능을 계속 쓸 수 있어요. 그 뒤에는 결제가 완료될 때까지 멈춰요.\\n\\n가장 빠른 방법은 결제 수단을 바꾸는 거예요.\\n\\n결제 수단 변경하기 https://sampleco.test/account/billing\\n\\n----------------------------------------\\n\\nSampleCo 계정이 있어서 보내 드리는 메일이에요."
}
`;

exports[`스냅숏: priceChange (en) 1`] = `
{
  "subject": "Your SampleCo Pro price changes on November 15, 2026",
  "html": "<!DOCTYPE html PUBLIC \\"-//W3C//DTD XHTML 1.0 Transitional//EN\\" \\"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\\"><html dir=\\"ltr\\" lang=\\"en\\"><head><meta content=\\"text/html; charset=UTF-8\\" http-equiv=\\"Content-Type\\"/><meta name=\\"x-apple-disable-message-reformatting\\"/><title>Please review and respond by November 1, 2026 at 2:59 PM UTC.</title></head><body dir=\\"ltr\\" lang=\\"en\\" style=\\"background-color:#f6f6f4;margin:0;padding:0\\"><!--$--><!--html--><!--head--><div style=\\"display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0\\" data-skip-in-text=\\"true\\">Please review and respond by November 1, 2026 at 2:59 PM UTC.<div> ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿</div></div><!--body--><table border=\\"0\\" width=\\"100%\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" align=\\"center\\"><tbody><tr><td dir=\\"ltr\\" lang=\\"en\\" style=\\"background-color:#f6f6f4;font-family:-apple-system, &#x27;Segoe UI&#x27;, &#x27;Apple SD Gothic Neo&#x27;, &#x27;Malgun Gothic&#x27;, sans-serif;margin:0;padding:24px 0\\"><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"max-width:560px;background-color:#ffffff;border-radius:8px;margin:0 auto\\"><tbody><tr style=\\"width:100%\\"><td style=\\"padding:32px\\"><h1 style=\\"color:#1a1a1a;font-size:22px;line-height:30px;margin:0 0 16px\\">Your price is changing</h1><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">Hi Jamie,</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">The price of your Pro plan will change from $9.00 (plus applicable tax) to $12.00 (plus applicable tax), starting November 15, 2026.</p><p style=\\"font-size:15px;line-height:24px;color:#1a1a1a;margin:0 0 12px;font-weight:600;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">To continue at the new price, please accept by November 1, 2026 at 2:59 PM UTC.</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">If we do not hear from you by then, we will not charge the new price. No response is not consent.</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">If you do not want to continue, you can cancel your subscription before November 15, 2026.</p><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"margin:20px 0 8px\\"><tbody><tr><td><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"margin:0 0 12px\\"><tbody><tr><td><a href=\\"https://sampleco.test/billing/price-change/accept\\" style=\\"line-height:100%;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:#1a1a1a;border-radius:6px;color:#ffffff;font-size:15px;font-weight:600;padding:12px 20px;padding-top:12px;padding-right:20px;padding-bottom:12px;padding-left:20px\\" target=\\"_blank\\"><span><!--[if mso]><i style=\\"mso-font-width:500%;mso-text-raise:18px\\" hidden>&#8202;&#8202;</i><![endif]--></span><span style=\\"max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:9px\\">Accept the new price</span><span><!--[if mso]><i style=\\"mso-font-width:500%\\" hidden>&#8202;&#8202;&#8203;</i><![endif]--></span></a><p data-skip-in-text=\\"true\\" data-lf-fallback-link=\\"true\\" style=\\"font-size:12px;line-height:18px;color:#777777;margin:6px 0 0;word-break:break-all;margin-top:6px;margin-right:0;margin-bottom:0;margin-left:0\\">If the button doesn&#x27;t work, copy this link into your browser: <a href=\\"https://sampleco.test/billing/price-change/accept\\" style=\\"color:#555555;text-decoration-line:none;text-decoration:underline\\" target=\\"_blank\\">https://sampleco.test/billing/price-change/accept</a></p></td></tr></tbody></table><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"margin:0 0 12px\\"><tbody><tr><td><a href=\\"https://sampleco.test/billing/cancel\\" style=\\"line-height:100%;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:#ffffff;border:1px solid #1a1a1a;border-radius:6px;color:#1a1a1a;font-size:15px;font-weight:600;padding:11px 19px;padding-top:11px;padding-right:19px;padding-bottom:11px;padding-left:19px\\" target=\\"_blank\\"><span><!--[if mso]><i style=\\"mso-font-width:475%;mso-text-raise:16.5px\\" hidden>&#8202;&#8202;</i><![endif]--></span><span style=\\"max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:8.25px\\">Cancel my subscription</span><span><!--[if mso]><i style=\\"mso-font-width:475%\\" hidden>&#8202;&#8202;&#8203;</i><![endif]--></span></a><p data-skip-in-text=\\"true\\" data-lf-fallback-link=\\"true\\" style=\\"font-size:12px;line-height:18px;color:#777777;margin:6px 0 0;word-break:break-all;margin-top:6px;margin-right:0;margin-bottom:0;margin-left:0\\">If the button doesn&#x27;t work, copy this link into your browser: <a href=\\"https://sampleco.test/billing/cancel\\" style=\\"color:#555555;text-decoration-line:none;text-decoration:underline\\" target=\\"_blank\\">https://sampleco.test/billing/cancel</a></p></td></tr></tbody></table></td></tr></tbody></table><hr style=\\"width:100%;border:none;border-color:#e5e5e5;border-top:1px solid #eaeaea;margin:24px 0 16px\\"/><p style=\\"font-size:12px;line-height:18px;color:#777777;margin:0;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0\\">You are receiving this email because you have an account with SampleCo.</p></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>",
  "text": "YOUR PRICE IS CHANGING\\n\\nHi Jamie,\\n\\nThe price of your Pro plan will change from $9.00 (plus applicable tax) to $12.00 (plus applicable tax), starting November 15, 2026.\\n\\nTo continue at the new price, please accept by November 1, 2026 at 2:59 PM UTC.\\n\\nIf we do not hear from you by then, we will not charge the new price. No response is not consent.\\n\\nIf you do not want to continue, you can cancel your subscription before November 15, 2026.\\n\\nAccept the new price https://sampleco.test/billing/price-change/accept\\n\\nCancel my subscription https://sampleco.test/billing/cancel\\n\\n----------------------------------------\\n\\nYou are receiving this email because you have an account with SampleCo."
}
`;

exports[`스냅숏: priceChange (ko) 1`] = `
{
  "subject": "SampleCo Pro 요금이 2026년 11월 15일부터 바뀌어요",
  "html": "<!DOCTYPE html PUBLIC \\"-//W3C//DTD XHTML 1.0 Transitional//EN\\" \\"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\\"><html dir=\\"ltr\\" lang=\\"ko\\"><head><meta content=\\"text/html; charset=UTF-8\\" http-equiv=\\"Content-Type\\"/><meta name=\\"x-apple-disable-message-reformatting\\"/><title>2026년 11월 1일 오후 11:59 GMT+9까지 확인하고 응답해 주세요.</title></head><body dir=\\"ltr\\" lang=\\"en\\" style=\\"background-color:#f6f6f4;margin:0;padding:0\\"><!--$--><!--html--><!--head--><div style=\\"display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0\\" data-skip-in-text=\\"true\\">2026년 11월 1일 오후 11:59 GMT+9까지 확인하고 응답해 주세요.<div> ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿</div></div><!--body--><table border=\\"0\\" width=\\"100%\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" align=\\"center\\"><tbody><tr><td dir=\\"ltr\\" lang=\\"en\\" style=\\"background-color:#f6f6f4;font-family:-apple-system, &#x27;Segoe UI&#x27;, &#x27;Apple SD Gothic Neo&#x27;, &#x27;Malgun Gothic&#x27;, sans-serif;margin:0;padding:24px 0\\"><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"max-width:560px;background-color:#ffffff;border-radius:8px;margin:0 auto\\"><tbody><tr style=\\"width:100%\\"><td style=\\"padding:32px\\"><h1 style=\\"color:#1a1a1a;font-size:22px;line-height:30px;margin:0 0 16px\\">요금이 바뀌어요</h1><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">지민님, 안녕하세요.</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">2026년 11월 15일부터 Pro 요금제 가격이 바뀌어요: ₩9,900 (부가세 포함) → ₩12,900 (부가세 포함)</p><p style=\\"font-size:15px;line-height:24px;color:#1a1a1a;margin:0 0 12px;font-weight:600;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">새 가격으로 계속 이용하려면 2026년 11월 1일 오후 11:59 GMT+9까지 동의해 주세요.</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">그때까지 응답이 없으면 새 가격으로 청구하지 않아요. 응답하지 않은 것은 동의가 아니에요.</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">계속 이용하지 않으려면 2026년 11월 15일 전에 언제든 구독을 해지할 수 있어요.</p><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"margin:20px 0 8px\\"><tbody><tr><td><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"margin:0 0 12px\\"><tbody><tr><td><a href=\\"https://sampleco.test/billing/price-change/accept\\" style=\\"line-height:100%;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:#1a1a1a;border-radius:6px;color:#ffffff;font-size:15px;font-weight:600;padding:12px 20px;padding-top:12px;padding-right:20px;padding-bottom:12px;padding-left:20px\\" target=\\"_blank\\"><span><!--[if mso]><i style=\\"mso-font-width:500%;mso-text-raise:18px\\" hidden>&#8202;&#8202;</i><![endif]--></span><span style=\\"max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:9px\\">새 가격에 동의하기</span><span><!--[if mso]><i style=\\"mso-font-width:500%\\" hidden>&#8202;&#8202;&#8203;</i><![endif]--></span></a><p data-skip-in-text=\\"true\\" data-lf-fallback-link=\\"true\\" style=\\"font-size:12px;line-height:18px;color:#777777;margin:6px 0 0;word-break:break-all;margin-top:6px;margin-right:0;margin-bottom:0;margin-left:0\\">버튼이 열리지 않으면 아래 링크를 브라우저에 붙여 넣어 주세요: <a href=\\"https://sampleco.test/billing/price-change/accept\\" style=\\"color:#555555;text-decoration-line:none;text-decoration:underline\\" target=\\"_blank\\">https://sampleco.test/billing/price-change/accept</a></p></td></tr></tbody></table><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"margin:0 0 12px\\"><tbody><tr><td><a href=\\"https://sampleco.test/billing/cancel\\" style=\\"line-height:100%;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:#ffffff;border:1px solid #1a1a1a;border-radius:6px;color:#1a1a1a;font-size:15px;font-weight:600;padding:11px 19px;padding-top:11px;padding-right:19px;padding-bottom:11px;padding-left:19px\\" target=\\"_blank\\"><span><!--[if mso]><i style=\\"mso-font-width:475%;mso-text-raise:16.5px\\" hidden>&#8202;&#8202;</i><![endif]--></span><span style=\\"max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:8.25px\\">구독 해지하기</span><span><!--[if mso]><i style=\\"mso-font-width:475%\\" hidden>&#8202;&#8202;&#8203;</i><![endif]--></span></a><p data-skip-in-text=\\"true\\" data-lf-fallback-link=\\"true\\" style=\\"font-size:12px;line-height:18px;color:#777777;margin:6px 0 0;word-break:break-all;margin-top:6px;margin-right:0;margin-bottom:0;margin-left:0\\">버튼이 열리지 않으면 아래 링크를 브라우저에 붙여 넣어 주세요: <a href=\\"https://sampleco.test/billing/cancel\\" style=\\"color:#555555;text-decoration-line:none;text-decoration:underline\\" target=\\"_blank\\">https://sampleco.test/billing/cancel</a></p></td></tr></tbody></table></td></tr></tbody></table><hr style=\\"width:100%;border:none;border-color:#e5e5e5;border-top:1px solid #eaeaea;margin:24px 0 16px\\"/><p style=\\"font-size:12px;line-height:18px;color:#777777;margin:0;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0\\">SampleCo 계정이 있어서 보내 드리는 메일이에요.</p></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>",
  "text": "요금이 바뀌어요\\n\\n지민님, 안녕하세요.\\n\\n2026년 11월 15일부터 Pro 요금제 가격이 바뀌어요: ₩9,900 (부가세 포함) → ₩12,900 (부가세 포함)\\n\\n새 가격으로 계속 이용하려면 2026년 11월 1일 오후 11:59 GMT+9까지 동의해 주세요.\\n\\n그때까지 응답이 없으면 새 가격으로 청구하지 않아요. 응답하지 않은 것은 동의가 아니에요.\\n\\n계속 이용하지 않으려면 2026년 11월 15일 전에 언제든 구독을 해지할 수 있어요.\\n\\n새 가격에 동의하기 https://sampleco.test/billing/price-change/accept\\n\\n구독 해지하기 https://sampleco.test/billing/cancel\\n\\n----------------------------------------\\n\\nSampleCo 계정이 있어서 보내 드리는 메일이에요."
}
`;

exports[`스냅숏: verifyEmail (en) 1`] = `
{
  "subject": "Confirm your email for SampleCo",
  "html": "<!DOCTYPE html PUBLIC \\"-//W3C//DTD XHTML 1.0 Transitional//EN\\" \\"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\\"><html dir=\\"ltr\\" lang=\\"en\\"><head><meta content=\\"text/html; charset=UTF-8\\" http-equiv=\\"Content-Type\\"/><meta name=\\"x-apple-disable-message-reformatting\\"/><title>Confirm this email address for your SampleCo account.</title></head><body dir=\\"ltr\\" lang=\\"en\\" style=\\"background-color:#f6f6f4;margin:0;padding:0\\"><!--$--><!--html--><!--head--><div style=\\"display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0\\" data-skip-in-text=\\"true\\">Confirm this email address for your SampleCo account.<div> ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿</div></div><!--body--><table border=\\"0\\" width=\\"100%\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" align=\\"center\\"><tbody><tr><td dir=\\"ltr\\" lang=\\"en\\" style=\\"background-color:#f6f6f4;font-family:-apple-system, &#x27;Segoe UI&#x27;, &#x27;Apple SD Gothic Neo&#x27;, &#x27;Malgun Gothic&#x27;, sans-serif;margin:0;padding:24px 0\\"><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"max-width:560px;background-color:#ffffff;border-radius:8px;margin:0 auto\\"><tbody><tr style=\\"width:100%\\"><td style=\\"padding:32px\\"><h1 style=\\"color:#1a1a1a;font-size:22px;line-height:30px;margin:0 0 16px\\">Confirm your email address</h1><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">Hi Jamie,</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">Please confirm that this is your email address. We use it for receipts, password resets and security notices.</p><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"margin:20px 0 8px\\"><tbody><tr><td><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"margin:0 0 12px\\"><tbody><tr><td><a href=\\"https://sampleco.test/api/auth/verify-email?token=test-token\\" style=\\"line-height:100%;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:#1a1a1a;border-radius:6px;color:#ffffff;font-size:15px;font-weight:600;padding:12px 20px;padding-top:12px;padding-right:20px;padding-bottom:12px;padding-left:20px\\" target=\\"_blank\\"><span><!--[if mso]><i style=\\"mso-font-width:500%;mso-text-raise:18px\\" hidden>&#8202;&#8202;</i><![endif]--></span><span style=\\"max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:9px\\">Confirm email address</span><span><!--[if mso]><i style=\\"mso-font-width:500%\\" hidden>&#8202;&#8202;&#8203;</i><![endif]--></span></a><p data-skip-in-text=\\"true\\" data-lf-fallback-link=\\"true\\" style=\\"font-size:12px;line-height:18px;color:#777777;margin:6px 0 0;word-break:break-all;margin-top:6px;margin-right:0;margin-bottom:0;margin-left:0\\">If the button doesn&#x27;t work, copy this link into your browser: <a href=\\"https://sampleco.test/api/auth/verify-email?token=test-token\\" style=\\"color:#555555;text-decoration-line:none;text-decoration:underline\\" target=\\"_blank\\">https://sampleco.test/api/auth/verify-email?token=test-token</a></p></td></tr></tbody></table></td></tr></tbody></table><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">This link works for 1 hour. If it has expired, you can ask for a new one after signing in.</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">If you did not ask for this, you can ignore this email.</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">Didn&#x27;t create this account? Use the link below and we will delete it.</p><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"margin:20px 0 8px\\"><tbody><tr><td><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"margin:0 0 12px\\"><tbody><tr><td><a href=\\"https://sampleco.test/api/auth/not-me?t=test-not-me\\" style=\\"line-height:100%;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:#ffffff;border:1px solid #1a1a1a;border-radius:6px;color:#1a1a1a;font-size:15px;font-weight:600;padding:11px 19px;padding-top:11px;padding-right:19px;padding-bottom:11px;padding-left:19px\\" target=\\"_blank\\"><span><!--[if mso]><i style=\\"mso-font-width:475%;mso-text-raise:16.5px\\" hidden>&#8202;&#8202;</i><![endif]--></span><span style=\\"max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:8.25px\\">This wasn&#x27;t me</span><span><!--[if mso]><i style=\\"mso-font-width:475%\\" hidden>&#8202;&#8202;&#8203;</i><![endif]--></span></a><p data-skip-in-text=\\"true\\" data-lf-fallback-link=\\"true\\" style=\\"font-size:12px;line-height:18px;color:#777777;margin:6px 0 0;word-break:break-all;margin-top:6px;margin-right:0;margin-bottom:0;margin-left:0\\">If the button doesn&#x27;t work, copy this link into your browser: <a href=\\"https://sampleco.test/api/auth/not-me?t=test-not-me\\" style=\\"color:#555555;text-decoration-line:none;text-decoration:underline\\" target=\\"_blank\\">https://sampleco.test/api/auth/not-me?t=test-not-me</a></p></td></tr></tbody></table></td></tr></tbody></table><hr style=\\"width:100%;border:none;border-color:#e5e5e5;border-top:1px solid #eaeaea;margin:24px 0 16px\\"/><p style=\\"font-size:12px;line-height:18px;color:#777777;margin:0;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0\\">You are receiving this email because you have an account with SampleCo.</p></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>",
  "text": "CONFIRM YOUR EMAIL ADDRESS\\n\\nHi Jamie,\\n\\nPlease confirm that this is your email address. We use it for receipts, password resets and security notices.\\n\\nConfirm email address https://sampleco.test/api/auth/verify-email?token=test-token\\n\\nThis link works for 1 hour. If it has expired, you can ask for a new one after signing in.\\n\\nIf you did not ask for this, you can ignore this email.\\n\\nDidn't create this account? Use the link below and we will delete it.\\n\\nThis wasn't me https://sampleco.test/api/auth/not-me?t=test-not-me\\n\\n----------------------------------------\\n\\nYou are receiving this email because you have an account with SampleCo."
}
`;

