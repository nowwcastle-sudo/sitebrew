exports[`스냅숏: emailChangeConfirm (en) 1`] = `
{
  "subject": "Approve your SampleCo email change",
  "html": "<!DOCTYPE html PUBLIC \\"-//W3C//DTD XHTML 1.0 Transitional//EN\\" \\"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\\"><html dir=\\"ltr\\" lang=\\"en\\"><head><meta content=\\"text/html; charset=UTF-8\\" http-equiv=\\"Content-Type\\"/><meta name=\\"x-apple-disable-message-reformatting\\"/><title>Someone asked to change your sign-in email to new-address@example.test.</title></head><body dir=\\"ltr\\" lang=\\"en\\" style=\\"background-color:#f6f6f4;margin:0;padding:0\\"><!--$--><!--html--><!--head--><div style=\\"display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0\\" data-skip-in-text=\\"true\\">Someone asked to change your sign-in email to new-address@example.test.<div> ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿</div></div><!--body--><table border=\\"0\\" width=\\"100%\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" align=\\"center\\"><tbody><tr><td dir=\\"ltr\\" lang=\\"en\\" style=\\"background-color:#f6f6f4;font-family:-apple-system, &#x27;Segoe UI&#x27;, &#x27;Apple SD Gothic Neo&#x27;, &#x27;Malgun Gothic&#x27;, sans-serif;margin:0;padding:24px 0\\"><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"max-width:560px;background-color:#ffffff;border-radius:8px;margin:0 auto\\"><tbody><tr style=\\"width:100%\\"><td style=\\"padding:32px\\"><h1 style=\\"color:#1a1a1a;font-size:22px;line-height:30px;margin:0 0 16px\\">Approve your email change</h1><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">Hi Jamie,</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">We received a request to change the email address of your SampleCo account to new-address@example.test.</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">After you approve, we will send a confirmation link to the new address. The change happens only when that link is used.</p><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"margin:20px 0 8px\\"><tbody><tr><td><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"margin:0 0 12px\\"><tbody><tr><td><a href=\\"https://sampleco.test/api/auth/verify-email?token=test-approve\\" style=\\"line-height:100%;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:#1a1a1a;border-radius:6px;color:#ffffff;font-size:15px;font-weight:600;padding:12px 20px;padding-top:12px;padding-right:20px;padding-bottom:12px;padding-left:20px\\" target=\\"_blank\\"><span><!--[if mso]><i style=\\"mso-font-width:500%;mso-text-raise:18px\\" hidden>&#8202;&#8202;</i><![endif]--></span><span style=\\"max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:9px\\">Approve the change</span><span><!--[if mso]><i style=\\"mso-font-width:500%\\" hidden>&#8202;&#8202;&#8203;</i><![endif]--></span></a><p data-skip-in-text=\\"true\\" data-lf-fallback-link=\\"true\\" style=\\"font-size:12px;line-height:18px;color:#777777;margin:6px 0 0;word-break:break-all;margin-top:6px;margin-right:0;margin-bottom:0;margin-left:0\\">If the button doesn&#x27;t work, copy this link into your browser: <a href=\\"https://sampleco.test/api/auth/verify-email?token=test-approve\\" style=\\"color:#555555;text-decoration-line:none;text-decoration:underline\\" target=\\"_blank\\">https://sampleco.test/api/auth/verify-email?token=test-approve</a></p></td></tr></tbody></table></td></tr></tbody></table><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">This link works for 1 hour, then it stops working.</p><p style=\\"font-size:15px;line-height:24px;color:#1a1a1a;margin:0 0 12px;font-weight:600;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">If you did not ask for this, do not use the button and change your password.</p><hr style=\\"width:100%;border:none;border-color:#e5e5e5;border-top:1px solid #eaeaea;margin:24px 0 16px\\"/><p style=\\"font-size:12px;line-height:18px;color:#777777;margin:0;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0\\">You are receiving this email because you have an account with SampleCo.</p></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>",
  "text": "APPROVE YOUR EMAIL CHANGE\\n\\nHi Jamie,\\n\\nWe received a request to change the email address of your SampleCo account to new-address@example.test.\\n\\nAfter you approve, we will send a confirmation link to the new address. The change happens only when that link is used.\\n\\nApprove the change https://sampleco.test/api/auth/verify-email?token=test-approve\\n\\nThis link works for 1 hour, then it stops working.\\n\\nIf you did not ask for this, do not use the button and change your password.\\n\\n----------------------------------------\\n\\nYou are receiving this email because you have an account with SampleCo."
}
`;

exports[`스냅숏: emailChangeConfirm (ko) 1`] = `
{
  "subject": "SampleCo 이메일 변경을 승인해 주세요",
  "html": "<!DOCTYPE html PUBLIC \\"-//W3C//DTD XHTML 1.0 Transitional//EN\\" \\"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\\"><html dir=\\"ltr\\" lang=\\"ko\\"><head><meta content=\\"text/html; charset=UTF-8\\" http-equiv=\\"Content-Type\\"/><meta name=\\"x-apple-disable-message-reformatting\\"/><title>로그인 이메일을 new-address@example.test(으)로 바꾸려는 요청이 있었어요.</title></head><body dir=\\"ltr\\" lang=\\"en\\" style=\\"background-color:#f6f6f4;margin:0;padding:0\\"><!--$--><!--html--><!--head--><div style=\\"display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0\\" data-skip-in-text=\\"true\\">로그인 이메일을 new-address@example.test(으)로 바꾸려는 요청이 있었어요.<div> ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿</div></div><!--body--><table border=\\"0\\" width=\\"100%\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" align=\\"center\\"><tbody><tr><td dir=\\"ltr\\" lang=\\"en\\" style=\\"background-color:#f6f6f4;font-family:-apple-system, &#x27;Segoe UI&#x27;, &#x27;Apple SD Gothic Neo&#x27;, &#x27;Malgun Gothic&#x27;, sans-serif;margin:0;padding:24px 0\\"><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"max-width:560px;background-color:#ffffff;border-radius:8px;margin:0 auto\\"><tbody><tr style=\\"width:100%\\"><td style=\\"padding:32px\\"><h1 style=\\"color:#1a1a1a;font-size:22px;line-height:30px;margin:0 0 16px\\">이메일 변경을 승인해 주세요</h1><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">지민님, 안녕하세요.</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">SampleCo 계정의 이메일 주소를 new-address@example.test(으)로 바꾸려는 요청을 받았어요.</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">승인하면 새 주소로 확인 링크를 보내 드려요. 그 링크를 눌러야 실제로 바뀌어요.</p><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"margin:20px 0 8px\\"><tbody><tr><td><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"margin:0 0 12px\\"><tbody><tr><td><a href=\\"https://sampleco.test/api/auth/verify-email?token=test-approve\\" style=\\"line-height:100%;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:#1a1a1a;border-radius:6px;color:#ffffff;font-size:15px;font-weight:600;padding:12px 20px;padding-top:12px;padding-right:20px;padding-bottom:12px;padding-left:20px\\" target=\\"_blank\\"><span><!--[if mso]><i style=\\"mso-font-width:500%;mso-text-raise:18px\\" hidden>&#8202;&#8202;</i><![endif]--></span><span style=\\"max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:9px\\">변경 승인하기</span><span><!--[if mso]><i style=\\"mso-font-width:500%\\" hidden>&#8202;&#8202;&#8203;</i><![endif]--></span></a><p data-skip-in-text=\\"true\\" data-lf-fallback-link=\\"true\\" style=\\"font-size:12px;line-height:18px;color:#777777;margin:6px 0 0;word-break:break-all;margin-top:6px;margin-right:0;margin-bottom:0;margin-left:0\\">버튼이 열리지 않으면 아래 링크를 브라우저에 붙여 넣어 주세요: <a href=\\"https://sampleco.test/api/auth/verify-email?token=test-approve\\" style=\\"color:#555555;text-decoration-line:none;text-decoration:underline\\" target=\\"_blank\\">https://sampleco.test/api/auth/verify-email?token=test-approve</a></p></td></tr></tbody></table></td></tr></tbody></table><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">이 링크는 1시간 동안만 쓸 수 있고, 그 뒤에는 열리지 않아요.</p><p style=\\"font-size:15px;line-height:24px;color:#1a1a1a;margin:0 0 12px;font-weight:600;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">직접 요청하지 않았다면 버튼을 누르지 말고 비밀번호를 바꿔 주세요.</p><hr style=\\"width:100%;border:none;border-color:#e5e5e5;border-top:1px solid #eaeaea;margin:24px 0 16px\\"/><p style=\\"font-size:12px;line-height:18px;color:#777777;margin:0;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0\\">SampleCo 계정이 있어서 보내 드리는 메일이에요.</p></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>",
  "text": "이메일 변경을 승인해 주세요\\n\\n지민님, 안녕하세요.\\n\\nSampleCo 계정의 이메일 주소를 new-address@example.test(으)로 바꾸려는 요청을 받았어요.\\n\\n승인하면 새 주소로 확인 링크를 보내 드려요. 그 링크를 눌러야 실제로 바뀌어요.\\n\\n변경 승인하기 https://sampleco.test/api/auth/verify-email?token=test-approve\\n\\n이 링크는 1시간 동안만 쓸 수 있고, 그 뒤에는 열리지 않아요.\\n\\n직접 요청하지 않았다면 버튼을 누르지 말고 비밀번호를 바꿔 주세요.\\n\\n----------------------------------------\\n\\nSampleCo 계정이 있어서 보내 드리는 메일이에요."
}
`;

exports[`스냅숏: emailChanged (en) 1`] = `
{
  "subject": "Your SampleCo email address was changed",
  "html": "<!DOCTYPE html PUBLIC \\"-//W3C//DTD XHTML 1.0 Transitional//EN\\" \\"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\\"><html dir=\\"ltr\\" lang=\\"en\\"><head><meta content=\\"text/html; charset=UTF-8\\" http-equiv=\\"Content-Type\\"/><meta name=\\"x-apple-disable-message-reformatting\\"/><title>Your account email is now new-address@example.test.</title></head><body dir=\\"ltr\\" lang=\\"en\\" style=\\"background-color:#f6f6f4;margin:0;padding:0\\"><!--$--><!--html--><!--head--><div style=\\"display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0\\" data-skip-in-text=\\"true\\">Your account email is now new-address@example.test.<div> ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿</div></div><!--body--><table border=\\"0\\" width=\\"100%\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" align=\\"center\\"><tbody><tr><td dir=\\"ltr\\" lang=\\"en\\" style=\\"background-color:#f6f6f4;font-family:-apple-system, &#x27;Segoe UI&#x27;, &#x27;Apple SD Gothic Neo&#x27;, &#x27;Malgun Gothic&#x27;, sans-serif;margin:0;padding:24px 0\\"><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"max-width:560px;background-color:#ffffff;border-radius:8px;margin:0 auto\\"><tbody><tr style=\\"width:100%\\"><td style=\\"padding:32px\\"><h1 style=\\"color:#1a1a1a;font-size:22px;line-height:30px;margin:0 0 16px\\">Your email address was changed</h1><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">Hi Jamie,</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">The email address of your SampleCo account was changed to new-address@example.test. We will send account emails there from now on.</p><p style=\\"font-size:15px;line-height:24px;color:#1a1a1a;margin:0 0 12px;font-weight:600;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">If you did not make this change, reset your password right away and contact us.</p><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"margin:20px 0 8px\\"><tbody><tr><td><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"margin:0 0 12px\\"><tbody><tr><td><a href=\\"https://sampleco.test/forgot-password\\" style=\\"line-height:100%;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:#ffffff;border:1px solid #1a1a1a;border-radius:6px;color:#1a1a1a;font-size:15px;font-weight:600;padding:11px 19px;padding-top:11px;padding-right:19px;padding-bottom:11px;padding-left:19px\\" target=\\"_blank\\"><span><!--[if mso]><i style=\\"mso-font-width:475%;mso-text-raise:16.5px\\" hidden>&#8202;&#8202;</i><![endif]--></span><span style=\\"max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:8.25px\\">Secure my account</span><span><!--[if mso]><i style=\\"mso-font-width:475%\\" hidden>&#8202;&#8202;&#8203;</i><![endif]--></span></a><p data-skip-in-text=\\"true\\" data-lf-fallback-link=\\"true\\" style=\\"font-size:12px;line-height:18px;color:#777777;margin:6px 0 0;word-break:break-all;margin-top:6px;margin-right:0;margin-bottom:0;margin-left:0\\">If the button doesn&#x27;t work, copy this link into your browser: <a href=\\"https://sampleco.test/forgot-password\\" style=\\"color:#555555;text-decoration-line:none;text-decoration:underline\\" target=\\"_blank\\">https://sampleco.test/forgot-password</a></p></td></tr></tbody></table></td></tr></tbody></table><hr style=\\"width:100%;border:none;border-color:#e5e5e5;border-top:1px solid #eaeaea;margin:24px 0 16px\\"/><p style=\\"font-size:12px;line-height:18px;color:#777777;margin:0;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0\\">You are receiving this email because you have an account with SampleCo.</p></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>",
  "text": "YOUR EMAIL ADDRESS WAS CHANGED\\n\\nHi Jamie,\\n\\nThe email address of your SampleCo account was changed to new-address@example.test. We will send account emails there from now on.\\n\\nIf you did not make this change, reset your password right away and contact us.\\n\\nSecure my account https://sampleco.test/forgot-password\\n\\n----------------------------------------\\n\\nYou are receiving this email because you have an account with SampleCo."
}
`;

