-family:-apple-system, &#x27;Segoe UI&#x27;, &#x27;Apple SD Gothic Neo&#x27;, &#x27;Malgun Gothic&#x27;, sans-serif;margin:0;padding:24px 0\\"><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"max-width:560px;background-color:#ffffff;border-radius:8px;margin:0 auto\\"><tbody><tr style=\\"width:100%\\"><td style=\\"padding:32px\\"><h1 style=\\"color:#1a1a1a;font-size:22px;line-height:30px;margin:0 0 16px\\">You have a new inquiry</h1><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">Hi there,</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">Someone sent an inquiry through the contact form. Reply to them using the contact details below.</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 4px;margin-top:0;margin-right:0;margin-bottom:4px;margin-left:0\\">Reference: Q-7K3M9P2A</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 4px;margin-top:0;margin-right:0;margin-bottom:4px;margin-left:0\\">Received: September 30, 2026 at 3:00 AM UTC</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 4px;margin-top:0;margin-right:0;margin-bottom:4px;margin-left:0\\">Name: Jamie</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 4px;margin-top:0;margin-right:0;margin-bottom:4px;margin-left:0\\">Contact: jamie@example.com</p><p style=\\"font-size:15px;line-height:24px;color:#1a1a1a;margin:0 0 12px;font-weight:600;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">Message:</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">Hello</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">Do you offer team plans?</p><p style=\\"font-size:15px;line-height:24px;color:#333333;margin:0 0 12px;margin-top:0;margin-right:0;margin-bottom:12px;margin-left:0\\">This inquiry is deleted automatically on October 30, 2026.</p><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"margin:20px 0 8px\\"><tbody><tr><td><table align=\\"center\\" width=\\"100%\\" border=\\"0\\" cellPadding=\\"0\\" cellSpacing=\\"0\\" role=\\"presentation\\" style=\\"margin:0 0 12px\\"><tbody><tr><td><a href=\\"https://sampleco.test/admin/inquiries\\" style=\\"line-height:100%;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:#1a1a1a;border-radius:6px;color:#ffffff;font-size:15px;font-weight:600;padding:12px 20px;padding-top:12px;padding-right:20px;padding-bottom:12px;padding-left:20px\\" target=\\"_blank\\"><span><!--[if mso]><i style=\\"mso-font-width:500%;mso-text-raise:18px\\" hidden>&#8202;&#8202;</i><![endif]--></span><span style=\\"max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:9px\\">Open inquiries</span><span><!--[if mso]><i style=\\"mso-font-width:500%\\" hidden>&#8202;&#8202;&#8203;</i><![endif]--></span></a><p data-skip-in-text=\\"true\\" data-lf-fallback-link=\\"true\\" style=\\"font-size:12px;line-height:18px;color:#777777;margin:6px 0 0;word-break:break-all;margin-top:6px;margin-right:0;margin-bottom:0;margin-left:0\\">If the button doesn&#x27;t work, copy this link into your browser: <a href=\\"https://sampleco.test/admin/inquiries\\" style=\\"color:#555555;text-decoration-line:none;text-decoration:underline\\" target=\\"_blank\\">https://sampleco.test/admin/inquiries</a></p></td></tr></tbody></table></td></tr></tbody></table><hr style=\\"width:100%;border:none;border-color:#e5e5e5;border-top:1px solid #eaeaea;margin:24px 0 16px\\"/><p style=\\"font-size:12px;line-height:18px;color:#777777;margin:0;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0\\">You are receiving this email because inquiries to SampleCo are sent to this address.</p></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>",
  "text": "YOU HAVE A NEW INQUIRY\\n\\nHi there,\\n\\nSomeone sent an inquiry through the contact form. Reply to them using the contact details below.\\n\\nReference: Q-7K3M9P2A\\n\\nReceived: September 30, 2026 at 3:00 AM UTC\\n\\nName: Jamie\\n\\nContact: jamie@example.com\\n\\nMessage:\\n\\nHello\\n\\nDo you offer team plans?\\n\\nThis inquiry is deleted automatically on October 30, 2026.\\n\\nOpen inquiries https://sampleco.test/admin/inquiries\\n\\n----------------------------------------\\n\\nYou are receiving this email because inquiries to SampleCo are sent to this address."
}
`;

