    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@electric-sql/pglite-tools": "0.4.8",
    "@types/node": "24.19.2",
    "drizzle-kit": "0.31.11"
  }
}
