      "added": "[data-testid=\"shop-added\"]",
      "cartLine": "[data-block=\"cart-lines-table\"] [data-cart-line]",
      "recipient": "[data-block=\"cart-checkout-form\"] input[name=\"recipient\"]",
      "phone": "[data-block=\"cart-checkout-form\"] input[name=\"phone\"]",
      "postcode": "[data-block=\"cart-checkout-form\"] input[name=\"postcode\"]",
      "address1": "[data-block=\"cart-checkout-form\"] input[name=\"address1\"]",
      "pay": "[data-block=\"cart-checkout-form\"] form button[type=\"submit\"]",
      "mockPay": "[data-mock-pay] button[data-action=\"mock-pay\"]",
      "done": "[data-block=\"cart-checkout-form\"] [data-checkout=\"done\"]",
      "orderRow": "[data-block=\"account-order-history\"] [data-order]"
    }
  }
