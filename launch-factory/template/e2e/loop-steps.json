    },
    "signup": {
      "flow": "[data-flow=\"signup\"]",
      "email": "[data-flow=\"signup\"] input[name=\"email\"]",
      "password": "[data-flow=\"signup\"] input[name=\"password\"]",
      "next": "[data-flow=\"signup\"][data-step=\"1\"] form button[type=\"submit\"]",
      "requiredBoxes": "[data-flow=\"signup\"][data-step=\"2\"] [role=\"checkbox\"][data-consent=\"required\"]",
      "submit": "[data-flow=\"signup\"][data-step=\"2\"] form button[type=\"submit\"]",
      "finished": "[data-flow=\"signup\"][data-step=\"3\"], [data-already-signed-in]"
    },
    "signin": {
      "email": "[data-block=\"auth-sign-in\"] input[name=\"email\"]",
      "password": "[data-block=\"auth-sign-in\"] input[name=\"password\"]",
      "submit": "[data-block=\"auth-sign-in\"] form button[type=\"submit\"]",
      "done": "[data-block=\"auth-sign-in\"] [role=\"status\"], [data-already-signed-in]"
    },
    "payments": {
      "planLink": "a[href=\"/upgrade?plan=pro\"]",
      "withdrawalBox": "[role=\"dialog\"] [data-terms=\"consent\"] [role=\"checkbox\"]",
      "pay": "[role=\"dialog\"] [data-choice=\"primary\"]",
      "paid": "[role=\"dialog\"] [role=\"status\"]",
      "billingBlock": "[data-block=\"account-billing-manage\"]",
