      "done": "[data-testid=\"book-done\"]",
      "reference": "[data-testid=\"book-reference\"]",
      "manageReference": "#manage-reference",
      "manageContact": "#manage-contact",
      "manageFind": "form:has(#manage-reference) button[type=\"submit\"]",
      "manageFound": "[data-testid=\"manage-found\"]",
      "manageCancel": "[data-testid=\"manage-cancel\"]",
      "manageConfirm": "[data-testid=\"manage-confirm\"] button[type=\"submit\"]",
      "manageResult": "[data-testid=\"manage-result\"]"
    },
    "bookingDeposit": {
      "serviceSelect": "#book-service",
