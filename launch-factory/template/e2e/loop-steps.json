      "pay": "[data-testid=\"book-deposit-pay\"]",
      "mockPay": "[data-mock-pay] button[data-action=\"mock-pay\"]",
      "paid": "[data-testid=\"book-done\"][data-deposit=\"paid\"]",
      "manageDeposit": "[data-testid=\"manage-deposit\"]",
