{
  "note": "한 바퀴 시험(e2e/loop.mock.spec.ts)의 데이터. steps = 기능별로 돌릴 단계 id(순서가 곧 실행 순서), mail = 기능이 끝났을 때 메일 기록(LF_MOCK_OUTBOX)에 template 별로 정확히 이만큼 있어야 한다, selectors = 단계가 읽는 화면 표지. 단계 id 의 동작은 spec 의 RUNNERS 에 있고, 여기에만 있고 RUNNERS 에 없는 id 는 시험이 시작 전에 던진다. booking 은 즉시 확정 접수 → 예약 번호+이메일로 조회·취소 → 메일 3통(대표 알림·예약 확인·취소 확인)이고, booking-deposit 은 예약금이 있는 서비스(mock 에서만 있는 예시 서비스)로 접수 → 결제 대기(예약 안내 메일 1통) → 모의 결제 → 확정(대표 알림 1통 + 확정 메일 1통) → 취소·환불(취소 메일 1통)이고, 상점(shop)은 담기 확인 → 배송지 → 모의 결제 확인 칸 → 주문 확인 메일 1통 → 내 주문 목록이고, push·kakao 알림은 화면 단계가 없다(브라우저 권한·VAPID·Solapi 가 있어야 해서 한 바퀴에 넣지 않는다).",
  "steps": {
    "signup": ["signUp", "verifyMail", "signOut", "signIn"],
    "payments": ["upgrade", "checkout", "billingReturn", "receiptMail"],
    "inquiry": ["contact", "inquiryMail"],
    "booking": ["bookPage", "manageCancel", "bookingMail"],
    "booking-deposit": ["bookDepositPage", "payDeposit", "cancelDeposit", "bookingDepositMail"],
    "shop": ["addToCart", "checkoutAddress", "payMock", "orderMail", "orderHistory"]
  },
  "requires": {
    "payments": ["signup"],
    "booking-deposit": ["booking"],
    "shop": ["signup"]
  },
  "mail": {
    "signup": { "verifyEmail": 1 },
    "payments": { "orderConfirmation": 1 },
    "inquiry": { "inquiryNotice": 1, "inquiryReceipt": 1 },
    "booking": { "bookingNotice": 1, "bookingConfirmation": 1, "bookingCancellation": 1 },
    "booking-deposit": { "bookingNotice": 1, "bookingConfirmation": 2, "bookingCancellation": 1 },
    "shop": { "shopOrderConfirmation": 1 }
  },
  "expect": {
    "billingNone": "You don't have a paid plan",
    "billingStatusAfter": ["Active", "Free trial"]
  },
  "selectors": {
    "shell": {
