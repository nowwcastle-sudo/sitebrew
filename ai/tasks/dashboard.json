          "noBlock": {
            "mode": "pending",
            "reason": "새로 고침·N분 전 갱신 블록이 없다",
            "register": [
              "A87"
            ]
          }
        },
        {
          "kind": "trend-charts",
          "blockKinds": [
            "dashboard-panel"
          ],
          "allowedVariants": [
