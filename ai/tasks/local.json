  "legal": [
    {
      "basis": "의료법 제56조②2(치료경험담), ②4·8·14, 시행령 제23조",
      "appliesWhen": "의료 변형(병원·의원·치과·한의원)",
      "requirement": "치료경험담 후기·전후 사진·다른 의료기관과의 비교·근거 없는 인증/수상 배지·심의 안 받은 광고 문구를 싣지 않는다. 후기 칸(external-reviews 포함)을 끈다(운영자 판정 2026-09-26)",
      "source": "https://www.law.go.kr/LSW/lsLawLinkInfo.do?chrClsCd=010202&lsJoLnkSeq=1000916681"
    },
    {
      "basis": "의료법 제57조(심의 제외 항목)",
      "appliesWhen": "의료 변형",
      "requirement": "명칭·소재지·전화·진료과목·의료인 성명·성별·면허 종류·진료시간 같은 사실 정보로 홈을 채운다",
      "source": "https://www.admedical.org/guide/regulations.do"
    },
    {
      "basis": "전자상거래법 제10조",
      "appliesWhen": "온라인 주문·선물을 받을 때",
      "requirement": "통신판매업 신고번호를 포함한 초기 화면 사업자 정보",
      "source": "https://www.law.go.kr/LSW/lsLinkCommonInfo.do?lsJoLnkSeq=1022342373"
    }
  ],
