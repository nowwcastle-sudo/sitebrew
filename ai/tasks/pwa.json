          "noBlock": {
            "mode": "content",
            "reason": "상세 본문",
            "render": {
              "as": "prose",
              "heading": {
                "ko": "자세히",
                "en": "Details"
              },
              "from": [
                "detailBody"
              ]
            }
          }
        }
      ],
      "optional": []
    },
    {
      "id": "offline",
      "route": "/offline",
      "required": [
