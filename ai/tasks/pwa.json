    {
      "id": "completion",
      "route": "/done",
      "required": [
        {
          "kind": "result",
          "blockKinds": [],
          "allowedVariants": [],
          "noBlock": {
            "mode": "content",
            "reason": "앱 고유 결과 화면 — 확인 블록 셋(가입·예약·주문)과 뜻이 다르다",
            "render": {
              "as": "prose",
              "heading": {
                "ko": "결과",
                "en": "Result"
              },
              "from": [
                "resultBody"
              ]
            }
          }
        }
      ],
      "optional": [
        {
          "kind": "install-or-notify-offer",
          "blockKinds": [],
          "allowedVariants": [],
          "noBlock": {
            "mode": "pending",
            "reason": "PWA 설치·알림 유도 블록이 없다",
            "register": [
              "A69"
            ]
          }
        }
      ]
    }
  ],
  "globalSections": [
    {
      "kind": "bottom-tab-bar",
      "required": false,
      "mustContain": [
        "icon+label",
        "equal-width",
        "home-left",
        "all-right"
      ],
      "condition": "최상위 목적지 3~5개일 때 필수(판정 2026-09-26, §14-A pwa 예외). 가운데 「+」 없음, 하위 화면에서 숨김 가능"
    },
    {
      "kind": "connection-banner",
      "required": true,
      "mustContain": [
        "action-language"
      ]
    },
    {
      "kind": "update-toast",
      "required": true,
      "mustContain": [
        "새 버전이 있어요 — 새로고침"
      ]
    },
    {
      "kind": "install-prompt",
      "required": false,
      "mustContain": [
        "dismiss"
      ],
      "condition": "beforeinstallprompt 뒤에만, 핵심 여정 밖, 거절 기억. iOS 안내는 display-mode: browser에서만"
    }
  ],
  "sectionOrders": [
    {
      "id": "V1-tab-app",
      "order": [
        "app-bar",
        "primary-content",
        "bottom-tab-bar"
      ]
    },
    {
      "id": "V2-single-task",
      "order": [
        "app-bar",
        "primary-content",
        "primary-action-bar",
        "completion:result",
        "completion:install-or-notify-offer"
      ]
    },
    {
      "id": "V3-offline-first",
      "order": [
        "app-shell-cached",
        "offline-ready-toast",
        "connection-banner",
        "saved-pending-queue",
        "sync-complete",
        "update-toast"
      ]
    }
  ],
