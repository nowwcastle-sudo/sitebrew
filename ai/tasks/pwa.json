{
  "$comment": "생성물 — factory/scripts/gen-ai.mjs 로 다시 만든다. 손으로 고치지 않는다.",
  "id": "pwa",
  "source": "registry/factory/archetypes/pwa.json",
  "ref": "v0.1.1",
  "purpose": "설치해 앱처럼 쓰는 사용자가 연결이 불안정해도 핵심 과업을 끝낸다.",
  "coreTask": "① 설치 가능 판정: manifest 경고 0, 서비스 워커 등록, 첫 로드에 설치 배너·권한 요청 0. ② 네트워크를 끊고 홈·최근 본 화면 열기 → 미캐시 경로는 사용자 지정 오프라인 화면. ③ 오프라인 중 작업 1건 저장 → 재연결 → 동기화 완료 표시 확인. ④ standalone 에뮬레이션에서 하위 화면 → 앱 안 뒤로가기로 복귀, 탭바 위치가 스크롤 전후 동일.",
  "completion": "product",
  "locales": [
    "ko",
    "en"
  ],
  "pages": [
    {
      "id": "home",
      "route": "/",
      "required": [
        {
          "kind": "app-bar",
          "blockKinds": [
            "nav"
          ],
          "allowedVariants": [
            "block-nav-app-bar-tabs"
          ]
        },
        {
          "kind": "empty-state",
          "blockKinds": [
            "onboarding",
            "state-screen"
          ],
          "allowedVariants": [
            "block-onboarding-empty-first-action",
            "block-state-screen-empty-guide"
          ]
        },
        {
          "kind": "primary-content",
          "blockKinds": [],
          "allowedVariants": [],
          "noBlock": {
            "mode": "content",
            "reason": "앱 고유 주 화면(목록·입력) — 본문",
            "render": {
              "as": "cards",
              "heading": {
                "ko": "주요 기능",
                "en": "Main features"
              },
              "from": [
                "homeItems"
              ],
              "fields": {
                "title": "title",
                "summary": "body"
              }
            }
          }
        },
        {
          "kind": "skeleton",
          "blockKinds": [],
          "allowedVariants": [],
          "noBlock": {
            "mode": "part",
            "reason": "첫 화면 로딩 뼈대 — ui 부품",
            "parts": [
              "skeleton"
            ],
            "render": {
              "as": "skeleton",
              "heading": {
                "ko": "불러오는 중",
                "en": "Loading"
              }
            }
          }
        }
      ],
      "optional": [
        {
          "kind": "primary-action-bar",
          "blockKinds": [],
          "allowedVariants": [],
          "noBlock": {
            "mode": "pending",
            "reason": "bottom-tab/sticky-action-bar 가 pwa 를 archetypes 에 적지 않았다",
            "register": [
              "C71"
            ]
          }
        }
      ]
    },
    {
      "id": "sub-detail",
      "route": "/detail",
      "required": [
        {
          "kind": "app-bar",
          "blockKinds": [
            "nav"
          ],
          "allowedVariants": [
            "block-nav-app-bar-tabs"
          ]
        },
        {
          "kind": "detail-content",
          "blockKinds": [],
