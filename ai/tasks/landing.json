          "blockKinds": [
            "lead-capture"
          ],
          "allowedVariants": [
            "block-lead-capture-inline-newsletter",
            "block-lead-capture-magnet-preview"
          ]
        },
        {
          "kind": "final-cta",
          "blockKinds": [
            "final-cta"
          ],
          "allowedVariants": [
            "block-final-cta-full-band",
            "block-final-cta-kinetic-band",
            "block-final-cta-quiet-link-row",
            "block-final-cta-split-form-hint"
          ]
        }
      ],
      "optional": [
        {
          "kind": "pricing",
          "blockKinds": [
            "pricing"
          ],
          "allowedVariants": [
            "block-pricing-three-tier-cards"
          ]
        }
      ]
    }
  ],
  "globalSections": [
