  "legal": [
    {
      "basis": "개인정보 보호법 제15조·제22조",
      "appliesWhen": "신청 폼에서 이메일 등 개인정보를 받을 때",
      "requirement": "수집 목적·항목·보유 기간·동의 거부 권리와 불이익을 폼 곁에 알리고, 필수 동의와 선택 동의(광고성 수신)를 나눈다. 선택 동의는 해제된 채 시작한다",
      "source": "https://www.law.go.kr/LSW/lsInfoP.do?lsiSeq=283839"
    },
    {
      "basis": "정보통신망 이용촉진 및 정보보호 등에 관한 법률 제50조",
      "appliesWhen": "행사 소식·출시 알림 같은 영리 목적 광고성 정보를 전송할 때",
      "requirement": "수신자의 사전 동의를 받고, 수신 거부 방법을 알린다",
      "source": "https://www.law.go.kr/LSW/lsInfoP.do?lsiSeq=290001"
    }
  ],
  "legalPages": {
    "pages": [
      "privacy",
      "terms"
    ],
    "laws": {
      "ko": [
        "개인정보 보호법",
        "정보통신망 이용촉진 및 정보보호 등에 관한 법률"
      ],
      "en": [
        "GDPR",
        "CCPA"
      ]
    }
  },
  "seo": {
    "titleTemplate": "%s | {siteName}",
    "type": "website",
    "install": {
      "seoMetadata": "npx shadcn@4.21.0 add nowwcastle-sudo/sitebrew/seo-meta#v0.1.1 -y -o",
      "jsonLdFor": "npx shadcn@4.21.0 add nowwcastle-sudo/sitebrew/geo-entity#v0.1.1 -y -o"
    },
    "usage": "seoMetadata(content, page) → Next Metadata(generateMetadata) · jsonLdFor(content, page) → <script type=\"application/ld+json\">. titleTemplate 의 {siteName} 은 content.site 이름(없으면 원형의 회사·가게·제품·기관 이름)이고, type 은 원형 기본 종류다."
  },
  "conversion": [
    {
      "event": "form_submit",
      "match": {
        "form": [
