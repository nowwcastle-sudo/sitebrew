  "legal": [
    {
      "basis": "상품정보제공 고시(공정위)",
      "appliesWhen": "통신판매 상품 상세(항상)",
      "requirement": "품목별 항목(제조자·수입자, 제조국, 품질보증기준, A/S 책임자와 전화번호, KC 인증 대상이면 인증정보)을 HTML 표로",
      "source": "https://www.law.go.kr/LSW/admRulInfoP.do?admRulSeq=2000000026532"
    },
    {
      "basis": "전자상거래법(청약철회 7일) · DESIGN §9·§15",
      "appliesWhen": "통신판매 상품 상세(항상)",
      "requirement": "배송·교환·반품 요약(배송비, 반품 배송비 부담 주체, 7일 청약철회, 불가 사유)을 구매 영역 근처와 하단 양쪽에",
      "source": "DESIGN.md §9 v3 추가 줄·§15"
    }
  ],
